{
  "name": "kc3rts-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --mode pages --base=/KC3RTS/",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.mjs",
    "smoke:kc3": "node scripts/smoke.mjs --kc3",
    "smoke:pages": "npm run build:pages && node scripts/smoke.mjs --pages"
  },
  "dependencies": {
    "phoenix": "1.8.15",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "@types/phoenix": "1.6.7",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
