# One process owns one match. Only protocol replies go to stdout.
require Buf
require File
load!(__DIR__ + "load.kc3")
load!(__DIR__ + "rts/world.kc3")
load!(__DIR__ + "rts/protocol.kc3")

defmodule RTS.Port do
  def open_fd = cfn Buf* "buf_fd_open_r" (Buf, S32)
end
catalog = RTS.Core.catalog()
if RTS.Content.validate(catalog) != void do exit(1) end
content = RTS.Content.compile(catalog)
input = RTS.Port.open_fd(Buf.new_alloc((Uw) 8192), (S32) File.open_r("/dev/stdin"))
state = void
line = Buf.read_line(input)
while line do
  if Str.size(line) > 4096 do exit(1) end
  request = JSON.from_str(line)
  result = RTS.Protocol.handle(content, state, request)
  state = RTS.Data.get(result, "state")
  puts(RTS.Wire.encode(RTS.Protocol.reply(content, request, result)))
  line = Buf.read_line(input)
end
