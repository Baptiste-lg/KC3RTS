# A derived Facts index. Exact snapshots restore immediately; non-geometric
# changes refresh complete entity rows without rebuilding collision facts.
defmodule RTS.Spatial do
  def prepare = fn (content, layout, state) {
    cache = RTS.Data.get(content, "spatial_cache")
    # Taking consumes the single entry before the index can be mutated.
    saved = RTS.Data.slot_take(cache)
    restored = void
    if saved != void do
      restored = RTS.Spatial.restore(saved, layout, state)
    end
    if restored != void do restored else
      RTS.Spatial.build(content, layout, RTS.Data.get(state, "entities")) end
  }
  def restore = fn (saved, layout, state) {
    # Compare complete values in-place; the shared state envelope avoids
    # copying entity lists through prepare/restore on every cache hit.
    if RTS.Data.get(saved, "layout") != layout do void else
      if RTS.Data.field_equal?(saved, state, "entities") do saved else
        RTS.Spatial.refresh(saved, state)
      end
    end
  }
  def refresh = fn (saved, state) {
    entities = RTS.Data.get(state, "entities")
    pairs = RTS.Data.zip(RTS.Data.get(saved, "rows"), entities)
    if pairs == void do void else
      valid = true
      rows = List.map_filter(pairs, {{previous, speed, body, cells}, entity}, do
        if valid do
          # The compiled catalog owns this cache and is immutable: type_id
          # determines footprint and speed. Row order determines tick priority,
          # so never match reordered entities by ID alone.
          if previous != entity do
            valid = RTS.Data.field_equal?(previous, entity, "id") &&
              RTS.Data.field_equal?(previous, entity, "type_id") &&
              RTS.Data.field_equal?(previous, entity, "x") &&
              RTS.Data.field_equal?(previous, entity, "z")
          end
          {entity, speed, body, cells}
        else void end
      end)
      if valid do RTS.Data.merge(saved, %{"entities" => entities, "rows" => rows}) else void end
    end
  }
  def remember = fn (content, saved) {
    # Only the latest snapshot is needed: no graph indexing of its full payload.
    # The index inside it remains a Facts database used for collision queries.
    RTS.Data.slot_put(RTS.Data.get(content, "spatial_cache"), saved)
  }
  def build = fn (content, layout, entities) {
    index = Facts.database()
    rows = List.map_filter(entities, e, do
      d = RTS.World.definition(content, RTS.Data.get(e, "type_id"))
      if RTS.Data.get(d, "kind") == "unit" do
        id = RTS.Data.get(e, "id")
        x = RTS.Data.get(e, "x")
        z = RTS.Data.get(e, "z")
        size = RTS.Data.get(d, "footprint")
        body = {id, x, z, size}
        cells = RTS.Map.cover(layout, x, z, size)
        RTS.Spatial.reserve(index, cells, body, true)
        {e, RTS.Data.get(d, "speed"), body, cells}
      else {e, 0, void, []} end
    end)
    RTS.Data.share(%{"entities" => entities, "layout" => layout, "index" => index, "rows" => rows})
  }
  def reserve = fn (index, cells, body, add) {
    List.do(cells, cell, do
      if add do Facts.add_tags(index, cell, :body, body) else
        Facts.remove_tags(index, cell, :body, body) end
    end)
    void
  }
  def clear? = fn (index, cells, {id, x, z, size}) {
    valid = true
    List.do(cells, cell, do
      if valid do
        neighbors = Facts.collect_with_tags(index, cell, :body, ?, fn (fact) { fact.object })
        List.do(neighbors, {other_id, other_x, other_z, other_size}, do
          if other_id != id do
            distance = (size + other_size) / 2
            dx = x - other_x
            dz = z - other_z
            if dx < distance && dx > (0 - distance) && dz < distance && dz > (0 - distance) do valid = false end
          end
        end)
      end
    end)
    valid
  }
  # Return the already-checked cells for the subsequent reservation update.
  def available = fn (layout, mask, index, {id, x, z, size}) {
    body = {id, x, z, size}
    cells = RTS.Map.cover(layout, x, z, size)
    valid = cells != []
    List.do(cells, cell, do if Str.byte(mask, cell) == 35 do valid = false end end)
    if valid && RTS.Spatial.clear?(index, cells, body) do cells else [] end
  }
end
