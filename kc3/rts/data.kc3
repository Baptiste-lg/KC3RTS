require List
require Map
require Str

# KC3 structs share immutable payloads; map arguments otherwise copy their trees.
defmodule RTS.Shared do
  defstruct [value: %{}]
end

# Explicitly mutable, worker-local derived storage. Never canonical game data.
# The Tag field owns its value and is cleaned when the final struct alias dies.
defmodule RTS.Slot do
  defstruct [value: (Tag) ?]
end

defmodule RTS.Data do
  def share = fn (value) { if type(value) == RTS.Shared do value else %RTS.Shared{value: value} end }
  def unshare = fn (value) { if type(value) == RTS.Shared do value.value else value end }
  def get = cfn Tag "kc3rts_get" (Tag, Tag, Result)
  # Compare the same field in two maps without copying either field.
  def field_equal? = cfn Tag "kc3rts_field_equal" (Tag, Tag, Tag, Result)
  def slot = fn () { %RTS.Slot{value: void} }
  def slot_put = cfn Tag "kc3rts_slot_put" (Tag, Tag, Result)
  def slot_take = cfn Tag "kc3rts_slot_take" (Tag, Result)
  # Read a list field's head without copying its unused tail. Empty => void.
  def first = cfn Tag "kc3rts_first" (Tag, Tag, Result)
  def rest = cfn Tag "kc3rts_rest" (Tag, Tag, Result)
  # Pair proper lists without repeatedly copying their remaining tails.
  # Different lengths or non-lists => void; two empty lists => [].
  def zip = cfn Tag "kc3rts_zip" (Tag, Tag, Result)
  # Ordered tuple-column projection; omit Void rows/values like map_filter.
  # Invalid shapes/indices => void, successful empty projection => [].
  def column = cfn Tag "kc3rts_tuple_column" (Tag, Tag, Result)
  # Ordered bulk remove/add for integer-subject Facts. Unsupported inputs
  # return void BEFORE mutation; a successful batch returns true.
  def facts_exchange = cfn Tag "kc3rts_facts_exchange" (Tag, Tag, Tag, Tag, Tag, Tag, Result)
  def put = cfn Tag "kc3rts_put" (Tag, Tag, Tag, Result)
  def merge = cfn Tag "kc3rts_merge" (Tag, Tag, Result)
  def integer? = fn (value, minimum, maximum) {
    if is_integer?(value) do value >= minimum && value <= maximum else false end
  }
  def text? = fn (value, maximum) {
    if type(value) == Str do Str.size(value) > 0 && Str.size(value) <= maximum else false end
  }
  def id? = fn (value) {
    valid = RTS.Data.text?(value, 64)
    if type(value) != Str do value = "" end
    i = 0
    while valid && i < Str.size(value) do
      c = Str.byte(value, i)
      valid = (c >= 97 && c <= 122) || (i > 0 &&
        ((c >= 48 && c <= 57) || c == 46 || c == 95 || c == 45))
      i = i + 1
    end
    valid && Str.has_str?(value, ".") && (! Str.has_str?(value, "..")) &&
      (! Str.ends_with?(value, "."))
  }
  def list? = fn (value, maximum) {
    if type(value) == List do List.length(value) <= maximum else false end
  }
  def unique? = fn (values) { List.length(List.unique(values)) == List.length(values) }
  def index = fn (definitions) {
    result = %{}
    while definitions != [] do
      item = List.first(definitions)
      result = Map.put(result, RTS.Data.get(item, "id"), item)
      definitions = List.next(definitions)
    end
    result
  }
  # A one-item list distinguishes a false-valued match from absence ([]).
  def find_native = cfn Tag "kc3rts_find_field" (Tag, Tag, Tag, Result)
  def find = fn (values, key, expected) {
    found = RTS.Data.find_native(values, key, expected)
    if found == void do RTS.Data.find_reference(values, key, expected) else
      if found == [] do void else List.first(found) end
    end
  }
  def find_reference = fn (values, key, expected) {
    found = void
    List.do(values, item, do
      if found == void && RTS.Data.get(item, key) == expected do found = ^ item end
    end)
    found
  }

  # Generic ordered field selection. Criteria and game scheduling stay in KC3.
  def select_native = cfn Tag "kc3rts_select_field" (Tag, Tag, Tag, Tag, Result)
  def select = fn (values, key, relation, expected) {
    selected = RTS.Data.select_native(values, key, relation, expected)
    if selected == void do RTS.Data.select_reference(values, key, relation, expected) else selected end
  }
  def select_reference = fn (values, key, relation, expected) {
    if relation != :eq && relation != :ne && relation != :gt do void else
      List.map_filter(values, item, do
        value = RTS.Data.get(item, key)
        keep = if relation == :eq do value == expected else
          if relation == :ne do value != expected else value > expected end end
        if keep do item else void end
      end)
    end
  }

  def random_next = fn (seed) { seed * 48271 mod 2147483647 }
end
