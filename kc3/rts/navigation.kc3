defmodule RTS.Navigation do
  def order = fn (goal, revision) {
    %{"kind" => "move", "goal" => goal, "path" => [], "wait" => 0,
      "revision" => revision, "attempt" => 0, "priority" => 0}
  }
  def command = fn (content, state, slot, command) {
    ids = RTS.Data.get(command, "entity_ids")
    if (! RTS.World.selection?(content, state, slot, ids, "move")) do RTS.World.result(state, "invalid_selection") else
      if RTS.Data.get(command, "type") == "stop" do
        RTS.World.result(RTS.Navigation.apply(state, ids, %{}), void)
      else RTS.Navigation.move(content, state, List.sort(ids), command) end
    end
  }
  def move = fn (content, state, ids, command) {
    x = RTS.Data.get(command, "x")
    z = RTS.Data.get(command, "z")
    if (! RTS.Data.integer?(x, -9007199254740991, 9007199254740991)) ||
       (! RTS.Data.integer?(z, -9007199254740991, 9007199254740991)) do RTS.World.result(state, "invalid_location") else
      state = RTS.Map.cache(content, state)
      grid = RTS.Data.share(RTS.Map.grid(RTS.Data.get(state, "map")))
      nav = RTS.Data.share(RTS.Data.get(state, "navigation"))
      goal = RTS.Map.cell(grid, x, z)
      mask = RTS.Data.get(nav, "mask")
      if goal < 0 || Str.byte(mask, goal) == 35 do RTS.World.result(state, "invalid_location") else
        footprint = 0
        center_x = 0
        center_z = 0
        ranked = []
        others = []
        List.do(RTS.Data.get(state, "entities"), e, do
          d = RTS.World.definition(content, RTS.Data.get(e, "type_id"))
          size = RTS.Data.get(d, "footprint")
          id = RTS.Data.get(e, "id")
          if List.has?(ids, id) do
            ranked = [[RTS.Map.cell(grid, RTS.Data.get(e, "x"), RTS.Data.get(e, "z")), id] | ranked]
            center_x = center_x + RTS.Data.get(e, "x")
            center_z = center_z + RTS.Data.get(e, "z")
            if size > footprint do footprint = ^ size end
          else
            if RTS.Data.get(d, "kind") == "unit" do
              others = [[RTS.Data.get(e, "x"), RTS.Data.get(e, "z"), size] | others]
            end
          end
        end)
        slots = RTS.Navigation.slots(grid, mask, goal, footprint, others, List.length(ids))
        if List.length(slots) < List.length(ids) do RTS.World.result(state, "no_space") else
          orders = RTS.Data.share(%{})
          # Match spatial ordering, with IDs breaking ties, so formations retain
          # their lanes instead of all crossing toward the first free slot.
          ranked = List.sort(ranked)
          slots = List.sort(slots)
          width = RTS.Data.get(grid, "width")
          height = RTS.Data.get(grid, "height")
          direction_x = if x >= center_x / List.length(ids) do 1 else -1 end
          direction_z = if z >= center_z / List.length(ids) do 1 else -1 end
          List.do(ranked, entry, do
            id = access(entry, [1])
            cell = List.first(slots)
            order = RTS.Navigation.order(cell, RTS.Data.get(nav, "revision"))
            priority = width + height + direction_x * (cell mod width) + direction_z * (cell / width)
            orders = RTS.Data.put(orders, (Str) id, RTS.Data.share(RTS.Data.put(order, "priority", priority)))
            slots = List.next(slots)
          end)
          RTS.World.result(RTS.Navigation.apply(state, ids, orders), void)
        end
      end
    end
  }
  def slots = fn (grid, mask, goal, footprint, others, count) {
    width = RTS.Data.get(grid, "width")
    height = RTS.Data.get(grid, "height")
    stride = (footprint * 2 + 255) / 256 + 1
    result = []
    side = 1
    while side * side < count do side = side + 1 end
    radius = side / 2
    maximum = goal mod width / stride
    if (width - 1 - goal mod width) / stride > maximum do maximum = (width - 1 - goal mod width) / stride end
    if (goal / width) / stride > maximum do maximum = (goal / width) / stride end
    if (height - 1 - goal / width) / stride > maximum do maximum = (height - 1 - goal / width) / stride end
    # Fill a compact rectangle first; later rings compensate for obstacles.
    first = true
    while List.length(result) < count && radius <= maximum do
      dz = 0 - radius
      while dz <= radius do
        dx = 0 - radius
        while dx <= radius do
          included = if first do dx < side - radius && dz < side - radius else
            dx == (0 - radius) || dx == radius || dz == (0 - radius) || dz == radius end
          if included do
            col = goal mod width + dx * stride
            row = goal / width + dz * stride
            if col >= 0 && row >= 0 && col < width && row < height && List.length(result) < count do
              cell = row * width + col
              p = RTS.Map.point(grid, cell)
              x = RTS.Data.get(p, "x")
              z = RTS.Data.get(p, "z")
              valid = RTS.Map.fits?(grid, mask, x, z, footprint)
              List.do(others, other, do
                distance = (footprint + access(other, [2])) / 2
                dx_other = x - access(other, [0])
                dz_other = z - access(other, [1])
                if dx_other < distance && dx_other > (0 - distance) && dz_other < distance && dz_other > (0 - distance) do valid = false end
              end)
              if valid do result = [cell | result] end
            end
          end
          dx = dx + 1
        end
        dz = dz + 1
      end
      radius = radius + 1
      first = false
    end
    List.reverse(result)
  }
  def apply = fn (state, ids, orders) {
    RTS.Data.put(state, "entities", List.map_filter(RTS.Data.get(state, "entities"), e, do
      id = RTS.Data.get(e, "id")
      if List.has?(ids, id) do
        order = RTS.Data.get(orders, (Str) id)
        if order != void do order = RTS.Data.share(order) end
        RTS.Data.merge(e, %{"order" => order, "task" => void, "status" => if order == void do void else "planning" end})
      else e end
    end))
  }
  def step = fn (delta, speed) {
    if delta > speed do speed else if delta < (0 - speed) do 0 - speed else delta end end
  }
  def advance = fn (content, grid, entity, horizontal_first) {
    order = RTS.Data.get(entity, "order")
    path = RTS.Data.get(order, "path")
    if order == void || path == [] do entity else
      speed = RTS.Data.get(RTS.World.definition(content, RTS.Data.get(entity, "type_id")), "speed")
      body = {RTS.Data.get(entity, "id"), RTS.Data.get(entity, "x"), RTS.Data.get(entity, "z"), 0}
      {next, reached} = RTS.Navigation.propose(RTS.Map.layout(grid), body, speed, List.first(path), horizontal_first)
      RTS.Navigation.finish(entity, order, path, next, reached)
    end
  }
  def propose = fn ({width, height, ox, oz, cell_size}, {id, x, z, size}, speed, cell, horizontal_first) {
    tx = ox + (cell mod width) * cell_size + cell_size / 2
    tz = oz + (cell / width) * cell_size + cell_size / 2
    dx = tx - x
    dz = tz - z
    if dx != 0 && (horizontal_first || dz == 0) do x = x + RTS.Navigation.step(dx, speed) else
      z = z + RTS.Navigation.step(dz, speed) end
    {{id, x, z, size}, x == tx && z == tz}
  }
  def finish = fn (entity, order, path, {id, x, z, size}, reached) {
    if reached do
      path = List.next(path)
      # Reaching a waypoint renews the budget for a later, distinct obstruction.
      order = if path == [] do void else RTS.Data.merge(order, %{"path" => path, "wait" => 0, "attempt" => 0}) end
    end
    RTS.Data.merge(entity, %{"x" => x, "z" => z, "order" => order})
  }
  def near? = fn (map, entity, target) {
    cell = RTS.Map.cell(map, RTS.Data.get(entity, "x"), RTS.Data.get(entity, "z"))
    target_cell = RTS.Map.cell(map, RTS.Data.get(target, "x"), RTS.Data.get(target, "z"))
    cell == target_cell || List.has?(RTS.Map.neighbors(map, target_cell), cell)
  }
  def planner_mask = fn (content, state, grid, mask, e) {
    size = RTS.Data.get(RTS.World.definition(content, RTS.Data.get(e, "type_id")), "footprint")
    # Large units need clearance from both terrain and map edges.
    if size > 256 do
      original = ^ mask
      cell = 0
      while cell < Str.size(mask) do
        point = RTS.Map.point(grid, cell)
        if (! RTS.Map.fits?(grid, original, RTS.Data.get(point, "x"), RTS.Data.get(point, "z"), size)) do mask = RTS.Map.mark(mask, cell) end
        cell = cell + 1
      end
    end
    if RTS.Data.get(RTS.Data.get(e, "order"), "attempt") > 0 do
      List.do(RTS.Data.get(state, "entities"), other, do
        if RTS.Data.get(other, "id") != RTS.Data.get(e, "id") do
          d = RTS.World.definition(content, RTS.Data.get(other, "type_id"))
          if RTS.Data.get(d, "kind") == "unit" do
            clearance = RTS.Data.get(d, "footprint") + size
            ox = RTS.Data.get(other, "x")
            oz = RTS.Data.get(other, "z")
            List.do(RTS.Map.cells(grid, ox, oz, clearance), cell, do
              point = RTS.Map.point(grid, cell)
              dx = RTS.Data.get(point, "x") - ox
              dz = RTS.Data.get(point, "z") - oz
              if dx * 2 < clearance && dx * 2 > (0 - clearance) && dz * 2 < clearance && dz * 2 > (0 - clearance) do
                mask = RTS.Map.mark(mask, cell)
              end
            end)
          end
        end
      end)
    end
    mask
  }
  def entry = fn (grid, mask, e) {
    current = RTS.Map.cell(grid, RTS.Data.get(e, "x"), RTS.Data.get(e, "z"))
    best = ^ current
    distance = 9007199254740991
    List.do([current | RTS.Map.neighbors(grid, current)], cell, do
      if Str.byte(mask, cell) != 35 do
        point = RTS.Map.point(grid, cell)
        dx = RTS.Data.get(point, "x") - RTS.Data.get(e, "x")
        dz = RTS.Data.get(point, "z") - RTS.Data.get(e, "z")
        candidate = (if dx < 0 do 0 - dx else dx end) + (if dz < 0 do 0 - dz else dz end)
        if candidate < distance do
          best = ^ cell
          distance = ^ candidate
        end
      end
    end)
    best
  }
  def plan = fn (content, state, grid) {
    nav = RTS.Data.share(RTS.Data.get(state, "navigation"))
    budget = 128
    jobs = 8
    pending = List.sort(List.map_filter(RTS.Data.get(state, "entities"), e, do
      order = RTS.Data.get(e, "order")
      if RTS.Data.get(e, "status") == "planning" && order != void do
        id = RTS.Data.get(e, "id")
        [if RTS.Data.get(nav, "entity_id") == id do -100000 else 0 - RTS.Data.get(order, "priority") end, id]
      else void end
    end))
    List.do(pending, entry, do
      if budget > 0 && jobs > 0 do
        jobs = jobs - 1
        id = access(entry, [1])
        e = RTS.World.find(state, id)
        order = RTS.Data.get(e, "order")
        search = RTS.Data.get(nav, "search")
        before = 0
        if RTS.Data.get(nav, "entity_id") != id || search == void do
          mask = RTS.Navigation.planner_mask(content, state, grid, RTS.Data.get(nav, "mask"), e)
          start = RTS.Navigation.entry(grid, mask, e)
          goal = RTS.Data.get(order, "goal")
          path = RTS.Search.direct(grid, mask, start, goal, true)
          if path == [] do path = RTS.Search.direct(grid, mask, start, goal, false) end
          search = if path != [] do %{"expanded" => 0, "status" => "ready", "path" => path} else
            RTS.Data.put(RTS.Search.start(grid, start, goal, true), "mask", mask) end
        else before = RTS.Data.get(search, "expanded") end
        if RTS.Data.get(search, "status") == "planning" do
          search = RTS.Search.run(grid, RTS.Data.get(search, "mask"), search, budget)
        end
        used = RTS.Data.get(search, "expanded") - before
        budget = budget - used - 1
        status = RTS.Data.get(search, "status")
        if status == "planning" do
          nav = RTS.Data.merge(nav, %{"search" => search, "entity_id" => id})
          budget = 0
        else
          nav = RTS.Data.merge(nav, %{"search" => void, "entity_id" => 0})
          if status == "ready" do
            path = RTS.Data.get(search, "path")
            # The unit may be between centers after a collision. Moving back to
            # its start center would trap it against the unit following behind.
            if List.length(path) > 1 && List.first(path) == RTS.Map.cell(grid, RTS.Data.get(e, "x"), RTS.Data.get(e, "z")) do path = List.next(path) end
            e = RTS.Data.merge(e, %{"order" => RTS.Data.put(order, "path", path), "status" => void})
          else
            if RTS.Data.get(order, "attempt") > 0 do
              e = RTS.Data.merge(e, %{"order" => RTS.Data.put(order, "path", []), "status" => "waiting"})
            else e = RTS.Data.merge(e, %{"order" => void, "task" => void, "status" => "unreachable"}) end
          end
          state = RTS.World.put(state, e)
        end
      end
    end)
    RTS.Data.put(state, "navigation", RTS.Data.unshare(nav))
  }
  def tick = fn (content, state) {
    state = RTS.Map.cache(content, state)
    active = false
    List.do(RTS.Data.get(state, "entities"), e, do
      if RTS.Data.get(e, "order") != void do active = true end
    end)
    if (! active) do state else
    nav = RTS.Data.share(RTS.Data.get(state, "navigation"))
    revision = RTS.Data.get(nav, "revision")
    grid = RTS.Data.share(RTS.Map.grid(RTS.Data.get(state, "map")))
    state = RTS.Data.put(state, "entities", List.map_filter(RTS.Data.get(state, "entities"), e, do
      order = RTS.Data.get(e, "order")
      if order != void && RTS.Data.get(order, "revision") != revision do
        RTS.Data.merge(e, %{"order" => RTS.Data.share(RTS.Data.put(RTS.Navigation.order(RTS.Data.get(order, "goal"), revision), "priority", RTS.Data.get(order, "priority"))), "status" => "planning"})
      else e end
    end))
    state = RTS.Navigation.plan(content, state, grid)
    layout = RTS.Map.layout(grid)
    {buckets, rows} = RTS.Spatial.prepare(content, layout, RTS.Data.get(state, "entities"))
    mask = RTS.Data.get(nav, "mask")
    rows = List.map_filter(rows, {e, speed, body, occupied_cells}, do
      order = RTS.Data.get(e, "order")
      path = if order == void do [] else RTS.Data.get(order, "path") end
      updated = if RTS.Data.get(e, "status") == "waiting" && order != void do
        waited = RTS.Data.get(order, "wait") + 1
        if waited >= 70 do RTS.Data.merge(e, %{"order" => void, "task" => void, "status" => "blocked"}) else
          RTS.Data.merge(e, %{"order" => RTS.Data.put(order, "wait", waited), "status" => if waited mod 10 == 0 do "planning" else "waiting" end}) end
      else if path == [] do e else
        cell = List.first(path)
        {next, reached} = RTS.Navigation.propose(layout, body, speed, cell, true)
        cells = RTS.Spatial.available(layout, mask, buckets, next)
        if cells == [] do
          {next, reached} = RTS.Navigation.propose(layout, body, speed, cell, false)
          cells = RTS.Spatial.available(layout, mask, buckets, next)
        end
        if cells != [] do
          RTS.Spatial.reserve(buckets, occupied_cells, body, false)
          RTS.Spatial.reserve(buckets, cells, next, true)
          body = ^ next
          occupied_cells = ^ cells
          RTS.Navigation.finish(e, order, path, next, reached)
        else
          waited = RTS.Data.get(order, "wait") + 1
          if waited >= 70 do RTS.Data.merge(e, %{"order" => void, "task" => void, "status" => "blocked"}) else
            if waited >= 20 && RTS.Data.get(order, "attempt") == 0 do
              RTS.Data.merge(e, %{"order" => RTS.Data.merge(order, %{"path" => [], "wait" => waited, "attempt" => 1}), "status" => "planning"})
            else RTS.Data.put(e, "order", RTS.Data.put(order, "wait", waited)) end
          end
        end
      end
      end
      {updated, speed, body, occupied_cells}
    end)
    entities = List.map_filter(rows, {e, speed, body, cells}, do e end)
    RTS.Spatial.remember(content, layout, buckets, rows, entities)
    RTS.Data.put(state, "entities", entities)
    end
  }
  def field = fn (map, occupied, goal) {
    parents = RTS.Data.put(%{}, (Str) goal, goal)
    frontier = [goal]
    while frontier != [] do
      next = []
      while frontier != [] do
        cell = List.first(frontier)
        neighbors = RTS.Map.neighbors(map, cell)
        while neighbors != [] do
          neighbor = List.first(neighbors)
          key = (Str) neighbor
          if RTS.Data.get(occupied, key) != true && RTS.Data.get(parents, key) == void do
            parents = RTS.Data.put(parents, key, cell)
            next = [neighbor | next]
          end
          neighbors = List.next(neighbors)
        end
        frontier = List.next(frontier)
      end
      frontier = List.reverse(next)
    end
    parents
  }
  def target_route = fn (map, field, start, target) {
    cell = RTS.Map.cell(map, RTS.Data.get(target, "x"), RTS.Data.get(target, "z"))
    candidates = RTS.Map.neighbors(map, cell)
    best = void
    while candidates != [] do
      cell = List.first(candidates)
      if RTS.Data.get(field, (Str) cell) != void do
        path = [cell]
        while cell != start do
          cell = RTS.Data.get(field, (Str) cell)
          path = [cell | path]
        end
        if best == void || List.length(path) < List.length(best) do best = ^ path end
      end
      candidates = List.next(candidates)
    end
    if best == void do void else %{"kind" => "move", "path" => best, "offset" => %{"x" => 0, "z" => 0}} end
  }
  def nearest = fn (content, state, entity, candidates) {
    result = void
    if candidates != [] do
      map = RTS.Data.get(state, "map")
      start = RTS.Map.cell(map, RTS.Data.get(entity, "x"), RTS.Data.get(entity, "z"))
      field = RTS.Navigation.field(map, RTS.Map.occupied(content, state), start)
      while candidates != [] do
        target = List.first(candidates)
        route = RTS.Navigation.target_route(map, field, start, target)
        if route != void && (result == void || List.length(RTS.Data.get(route, "path")) < List.length(RTS.Data.get(RTS.Data.get(result, "order"), "path"))) do
          result = %{"target" => target, "order" => route}
        end
        candidates = List.next(candidates)
      end
    end
    if result != void do
      grid = RTS.Map.grid(RTS.Data.get(state, "map"))
      last = List.last(RTS.Data.get(RTS.Data.get(result, "order"), "path"))
      point = RTS.Map.point(RTS.Data.get(state, "map"), last)
      goal = RTS.Map.cell(grid, RTS.Data.get(point, "x"), RTS.Data.get(point, "z"))
      result = RTS.Data.put(result, "order", RTS.Navigation.order(goal, RTS.Data.get(RTS.Data.get(state, "navigation"), "revision")))
    end
    result
  }
end
