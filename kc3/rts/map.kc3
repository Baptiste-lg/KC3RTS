# P02 bounded field, four-unit cells. The same blocked cells drive routing and art.
defmodule RTS.Map do
  def opening = fn () {
    %{"width" => 12, "height" => 10, "cell_size" => 1024,
      "origin_x" => -6144, "origin_z" => -5120,
      "blocked" => []}
  }
  def nodes = fn () {
    List.map([17, 18, 29, 30, 38, 41, 42, 45, 77, 78, 86, 89, 90, 93, 101, 102], fn (cell) {
      resource = if List.has?([38, 93], cell) do "core.food" else
        if List.has?([45, 86], cell) do "core.gold" else
          if cell mod 3 == 0 do "core.stone" else "core.wood" end end end
      RTS.Data.merge(RTS.Map.point(RTS.Map.opening(), cell), %{"id" => cell + 1, "resource_id" => resource, "amount" => 200})
    })
  }
  def cell = fn (map, x, z) {
    dx = x - RTS.Data.get(map, "origin_x")
    dz = z - RTS.Data.get(map, "origin_z")
    size = RTS.Data.get(map, "cell_size")
    width = RTS.Data.get(map, "width")
    if dx < 0 || dz < 0 || dx >= width * size || dz >= RTS.Data.get(map, "height") * size do -1
    else (dz / size) * width + dx / size end
  }
  def point = fn (map, cell) {
    size = RTS.Data.get(map, "cell_size")
    width = RTS.Data.get(map, "width")
    %{"x" => RTS.Data.get(map, "origin_x") + (cell mod width) * size + size / 2,
      "z" => RTS.Data.get(map, "origin_z") + (cell / width) * size + size / 2}
  }
  def neighbors = fn (map, cell) {
    width = RTS.Data.get(map, "width")
    total = width * RTS.Data.get(map, "height")
    result = []
    if cell >= width do result = [cell - width | result] end
    if cell mod width > 0 do result = [cell - 1 | result] end
    if cell mod width < width - 1 do result = [cell + 1 | result] end
    if cell + width < total do result = [cell + width | result] end
    result
  }
  def occupied = fn (content, state) {
    map = RTS.Data.get(state, "map")
    occupied = %{}
    cells = RTS.Data.get(map, "blocked")
    while cells != [] do
      occupied = RTS.Data.put(occupied, (Str) List.first(cells), true)
      cells = List.next(cells)
    end
    nodes = RTS.Data.get(state, "nodes")
    while nodes != [] do
      node = List.first(nodes)
      if RTS.Data.get(node, "amount") > 0 do
        occupied = RTS.Data.put(occupied, (Str) RTS.Map.cell(map, RTS.Data.get(node, "x"), RTS.Data.get(node, "z")), true)
      end
      nodes = List.next(nodes)
    end
    entities = RTS.Data.get(state, "entities")
    while entities != [] do
      entity = List.first(entities)
      definition = RTS.World.definition(content, RTS.Data.get(entity, "type_id"))
      if RTS.Data.get(definition, "kind") == "building" do
        occupied = RTS.Data.put(occupied, (Str) RTS.Map.cell(map, RTS.Data.get(entity, "x"), RTS.Data.get(entity, "z")), true)
      end
      entities = List.next(entities)
    end
    occupied
  }
  # Navigation uses one-world-unit cells. Rendering/build placement retain the
  # coarser authoring grid; both derive coordinates from the same map metadata.
  def grid = fn (map) {
    scale = RTS.Data.get(map, "cell_size") / 256
    RTS.Data.merge(map, %{"width" => RTS.Data.get(map, "width") * scale,
      "height" => RTS.Data.get(map, "height") * scale, "cell_size" => 256})
  }
  def repeat = fn (value, count) {
    result = ""
    while count > 0 do
      if count mod 2 == 1 do result = result + value end
      count = count / 2
      if count > 0 do value = value + value end
    end
    result
  }
  def mark = fn (mask, cell) {
    if cell < 0 || cell >= Str.size(mask) do mask else
      Str.slice_cfn(mask, (Sw) 0, (Sw) cell) + "#" + Str.slice_cfn(mask, (Sw) (cell + 1), (Sw) Str.size(mask))
    end
  }
  def cells = fn (map, x, z, footprint) {
    size = RTS.Data.get(map, "cell_size")
    ox = RTS.Data.get(map, "origin_x")
    oz = RTS.Data.get(map, "origin_z")
    width = RTS.Data.get(map, "width")
    height = RTS.Data.get(map, "height")
    left = x - footprint / 2 - ox
    top = z - footprint / 2 - oz
    right = x + footprint / 2 - 1 - ox
    bottom = z + footprint / 2 - 1 - oz
    if left < 0 do left = 0 end
    if top < 0 do top = 0 end
    result = []
    row = top / size
    while row <= bottom / size && row < height do
      col = left / size
      while col <= right / size && col < width do
        result = [row * width + col | result]
        col = col + 1
      end
      row = row + 1
    end
    List.reverse(result)
  }
  def fits? = fn (map, mask, x, z, footprint) {
    half = footprint / 2
    ox = RTS.Data.get(map, "origin_x")
    oz = RTS.Data.get(map, "origin_z")
    size = RTS.Data.get(map, "cell_size")
    valid = x - half >= ox && z - half >= oz &&
      x + half <= ox + RTS.Data.get(map, "width") * size &&
      z + half <= oz + RTS.Data.get(map, "height") * size
    if valid do
      List.do(RTS.Map.cells(map, x, z, footprint), cell, do
        if Str.byte(mask, cell) == 35 do valid = false end
      end)
    end
    valid
  }
  # Tick-local scalar layout avoids repeatedly copying/looking up map fields.
  def layout = fn (map) {
    {RTS.Data.get(map, "width"), RTS.Data.get(map, "height"),
      RTS.Data.get(map, "origin_x"), RTS.Data.get(map, "origin_z"), RTS.Data.get(map, "cell_size")}
  }
  # Unlike cells (which clips static obstacles), cover rejects out-of-map bodies.
  # An in-bounds, positive footprint always covers at least one cell.
  def cover = fn ({width, height, ox, oz, size}, x, z, footprint) {
    half = footprint / 2
    left = x - half - ox
    top = z - half - oz
    right = x + half - 1 - ox
    bottom = z + half - 1 - oz
    if left < 0 || top < 0 || right >= width * size || bottom >= height * size do [] else
      left = left / size
      right = right / size
      top = top / size
      bottom = bottom / size
      if left == right && top == bottom do [top * width + left] else
        result = []
        row = ^ top
        while row <= bottom do
          col = ^ left
          while col <= right do
            result = [row * width + col | result]
            col = col + 1
          end
          row = row + 1
        end
        List.reverse(result)
      end
    end
  }
  def signature = fn (content, state) {
    obstacles = List.map_filter(RTS.Data.get(state, "nodes"), n, do
      if RTS.Data.get(n, "amount") > 0 do [RTS.Data.get(n, "x"), RTS.Data.get(n, "z"), RTS.Data.get(RTS.Data.get(state, "map"), "cell_size")] else void end
    end)
    List.do(RTS.Data.get(state, "entities"), e, do
      d = RTS.World.definition(content, RTS.Data.get(e, "type_id"))
      if RTS.Data.get(d, "kind") == "building" && RTS.Data.get(e, "hp") > 0 do
        obstacles = [[RTS.Data.get(e, "x"), RTS.Data.get(e, "z"), RTS.Data.get(d, "footprint")] | obstacles]
      end
    end)
    %{"map" => RTS.Data.get(state, "map"), "obstacles" => List.sort(obstacles)}
  }
  def cache = fn (content, state) {
    nav = RTS.Data.get(state, "navigation")
    signature = RTS.Map.signature(content, state)
    if RTS.Data.get(nav, "signature") == signature do state else
      map = RTS.Data.get(state, "map")
      grid = RTS.Map.grid(map)
      mask = RTS.Map.repeat(".", RTS.Data.get(grid, "width") * RTS.Data.get(grid, "height"))
      List.do(RTS.Data.get(map, "blocked"), cell, do
        point = RTS.Map.point(map, cell)
        List.do(RTS.Map.cells(grid, RTS.Data.get(point, "x"), RTS.Data.get(point, "z"), RTS.Data.get(map, "cell_size")), blocked, do mask = RTS.Map.mark(mask, blocked) end)
      end)
      List.do(RTS.Data.get(signature, "obstacles"), obstacle, do
        List.do(RTS.Map.cells(grid, access(obstacle, [0]), access(obstacle, [1]), access(obstacle, [2])), blocked, do mask = RTS.Map.mark(mask, blocked) end)
      end)
      RTS.Data.put(state, "navigation", %{"revision" => if nav == void do 1 else RTS.Data.get(nav, "revision") + 1 end,
        "signature" => signature, "mask" => mask, "search" => void, "entity_id" => 0})
    end
  }
end
