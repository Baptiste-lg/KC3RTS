defmodule RTS.Protocol do
  def handle = fn (content, state, request) {
    reason = void
    operation = RTS.Data.get(request, "operation")
    if (! RTS.Data.integer?(RTS.Data.get(request, "protocol_version"), 2, 2)) ||
       (! RTS.Data.integer?(RTS.Data.get(request, "ruleset_version"), 2, 2)) do
      reason = "incompatible_version"
    end
    if reason == void && RTS.Data.get(request, "content_hash") != RTS.Data.get(RTS.Data.get(content, "public"), "content_hash") do
      reason = "incompatible_content"
    end
    if reason == void do
      if operation == "new_match" do
        if state != void do reason = "match_exists" else
          factions = RTS.Data.get(request, "factions")
          if RTS.Data.get(request, "expected_revision") != 0 ||
             (! RTS.Data.integer?(RTS.Data.get(request, "seed"), 1, 2147483646)) ||
             (! RTS.Data.list?(factions, 2)) do reason = "invalid_request" else
            if List.length(factions) != 2 || (! RTS.Content.refs?(RTS.Data.get(content, "index"), factions, ["faction"])) do
              reason = "unknown_content"
            else
              state = RTS.World.opening(content, RTS.Data.get(request, "match_id"), RTS.Data.get(request, "seed"), factions)
            end
          end
        end
      else
        if state == void || RTS.Data.get(request, "match_id") != RTS.Data.get(state, "match_id") do
          reason = "unknown_match"
        else
          if operation != "snapshot" do
            if RTS.Data.get(request, "expected_revision") != RTS.Data.get(state, "revision") do
              reason = "stale_revision"
            else
              if operation == "tick" do state = RTS.World.tick(content, state) else
                if operation == "command" do
                  result = RTS.World.command(content, state, RTS.Data.get(request, "actor_slot"), RTS.Data.get(request, "command"))
                  state = RTS.Data.get(result, "state")
                  reason = RTS.Data.get(result, "reason")
                else reason = "invalid_command" end
              end
            end
          end
        end
      end
    end
    RTS.World.result(state, reason)
  }
  def reply = fn (content, request, result) {
    state = RTS.Data.get(result, "state")
    %{"protocol_version" => 2, "ruleset_version" => 2,
      "content_hash" => RTS.Data.get(RTS.Data.get(content, "public"), "content_hash"),
      "request_id" => RTS.Data.get(request, "request_id"), "match_id" => RTS.Data.get(request, "match_id"),
      "accepted" => RTS.Data.get(result, "accepted"), "reason" => RTS.Data.get(result, "reason"),
      "revision" => if state == void do 0 else RTS.Data.get(state, "revision") end, "state" => state}
  }
end
