# Integer world units: 256 per tile, ten simulation ticks per second.
# All mutations, resource accounting and production live in KC3.
defmodule RTS.World do
  def definition = fn (content, id) { RTS.Data.get(RTS.Data.get(content, "index"), id) }
  def result = fn (state, reason) { %{"state" => state, "accepted" => reason == void, "reason" => reason} }
  def pack_entity = fn (entity) {
    order = RTS.Data.get(entity, "order")
    if order != void && type(order) != RTS.Shared do
      entity = RTS.Data.put(entity, "order", RTS.Data.share(order))
    end
    RTS.Data.share(entity)
  }
  def pack = fn (state) {
    if type(state) == RTS.Shared do state else
    RTS.Data.share(RTS.Data.put(state, "entities", List.map_filter(RTS.Data.get(state, "entities"), e, do
      RTS.World.pack_entity(e)
    end)))
    end
  }
  def unpack = fn (state) {
    if state == void do void else
      Map.put(RTS.Data.unshare(state), "entities", List.map_filter(RTS.Data.get(state, "entities"), e, do
        Map.put(RTS.Data.unshare(e), "order", RTS.Data.unshare(RTS.Data.get(e, "order")))
      end))
    end
  }
  def entity = fn (content, faction, id, type_id, owner, x, z, construction) {
    definition = RTS.World.definition(content, type_id)
    override = RTS.Data.find(RTS.Data.get(RTS.World.definition(content, faction), "overrides"), "target", type_id)
    hp = RTS.Data.get(definition, "hp")
    if RTS.Data.get(override, "hp") != void do hp = RTS.Data.get(override, "hp") end
    %{"id" => id, "type_id" => type_id, "owner" => owner, "x" => x, "z" => z,
      "hp" => if construction == void do hp else 1 end, "max_hp" => hp,
      "construction" => construction, "order" => void, "task" => void,
      "cargo" => void, "queue" => [], "rally" => void, "status" => void}
  }
  def opening = fn (content, match_id, seed, factions) {
    players = []
    entities = []
    next_id = 1
    slot = 1
    while factions != [] do
      faction = List.first(factions)
      definition = RTS.World.definition(content, faction)
      stocks = %{}
      resources = RTS.Data.get(content, "resources")
      while resources != [] do
        stocks = RTS.Data.put(stocks, List.first(resources), 0)
        resources = List.next(resources)
      end
      players = List.append_one(players, %{"slot" => slot, "faction_id" => faction,
        "stocks" => RTS.Data.merge(stocks, RTS.Data.get(definition, "stocks"))})
      roster = RTS.Data.get(definition, "roster")
      offset = 0
      while roster != [] do
        entry = List.first(roster)
        count = RTS.Data.get(entry, "count")
        while count > 0 do
          origin = if slot == 1 do -3584 else 3584 end
          index = (offset - 512) / 512
          x = if offset == 0 do origin else (1536 + (index mod 3) * 512) * if slot == 1 do -1 else 1 end end
          z = if offset == 0 do 512 else if slot == 1 do -1536 + (index / 3) * 768 else 2560 - (index / 3) * 768 end end
          entities = List.append_one(entities, RTS.World.entity(content, faction, next_id,
            RTS.Data.get(entry, "type_id"), slot, x, z, void))
          next_id = next_id + 1
          offset = offset + 512
          count = count - 1
        end
        roster = List.next(roster)
      end
      slot = slot + 1
      factions = List.next(factions)
    end
    state = %{"schema_version" => 4, "content_hash" => RTS.Data.get(content, "content_hash"),
      "match_id" => match_id, "seed" => seed, "rng_state" => RTS.Data.random_next(seed),
      "tick" => 0, "revision" => 1, "next_entity_id" => next_id, "next_job_id" => 1,
      "players" => players, "entities" => entities, "map" => RTS.Map.opening(), "nodes" => RTS.Map.nodes(),
      "outcome" => %{"status" => "ongoing", "winner_slot" => void, "reason" => void}}
    RTS.Map.cache(content, RTS.World.refresh(content, state))
  }
  def find = fn (state, id) { RTS.Data.find(RTS.Data.get(state, "entities"), "id", id) }
  def player = fn (state, slot) { RTS.Data.find(RTS.Data.get(state, "players"), "slot", slot) }
  def put = fn (state, entity) {
    if type(state) == RTS.Shared do entity = RTS.World.pack_entity(entity) end
    RTS.Data.put(state, "entities", List.map_filter(RTS.Data.get(state, "entities"), e, do
      if RTS.Data.get(e, "id") == RTS.Data.get(entity, "id") do entity else e end
    end))
  }
  def remove = fn (state, id) {
    RTS.Data.put(state, "entities", List.filter(RTS.Data.get(state, "entities"), fn (e) {
      if RTS.Data.get(e, "id") != id do e else false end
    }))
  }
  def capable? = fn (content, e, slot, capability) {
    RTS.Data.get(e, "owner") == slot && RTS.Data.get(e, "hp") > 0 && RTS.Data.get(e, "construction") == void &&
      List.has?(RTS.Data.get(RTS.World.definition(content, RTS.Data.get(e, "type_id")), "capabilities"), capability)
  }
  def selection? = fn (content, state, slot, ids, capability) {
    valid = RTS.Data.list?(ids, 100) && ids != [] && RTS.Data.unique?(ids)
    if valid do
      count = 0
      List.do(ids, id, do if (! RTS.Data.integer?(id, 1, 9007199254740991)) do valid = false end end)
      List.do(RTS.Data.get(state, "entities"), e, do
        if List.has?(ids, RTS.Data.get(e, "id")) && RTS.World.capable?(content, e, slot, capability) do count = count + 1 end
      end)
      valid = valid && count == List.length(ids)
    end
    valid
  }

  def payable? = fn (state, slot, cost) {
    stocks = RTS.Data.get(RTS.World.player(state, slot), "stocks")
    List.all?(Map.keys(cost), fn (id) { RTS.Data.get(stocks, id) >= RTS.Data.get(cost, id) })
  }
  def creditable? = fn (content, state, slot, amount) {
    stocks = RTS.Data.get(RTS.World.player(state, slot), "stocks")
    List.all?(Map.keys(amount), fn (id) {
      RTS.Data.get(stocks, id) + RTS.Data.get(amount, id) <= RTS.Data.get(RTS.World.definition(content, id), "cap")
    })
  }
  def balance = fn (state, slot, amounts, sign) {
    player = RTS.World.player(state, slot)
    stocks = RTS.Data.get(player, "stocks")
    ids = Map.keys(amounts)
    while ids != [] do
      id = List.first(ids)
      stocks = RTS.Data.put(stocks, id, RTS.Data.get(stocks, id) + sign * RTS.Data.get(amounts, id))
      ids = List.next(ids)
    end
    RTS.Data.put(state, "players", List.map(RTS.Data.get(state, "players"), fn (p) {
      if RTS.Data.get(p, "slot") == slot do RTS.Data.put(p, "stocks", stocks) else p end
    }))
  }
  def population = fn (content, state, slot) {
    used = 0
    reserved = 0
    cap = 0
    entities = RTS.Data.get(state, "entities")
    while entities != [] do
      e = List.first(entities)
      if RTS.Data.get(e, "owner") == slot && RTS.Data.get(e, "hp") > 0 do
        d = RTS.World.definition(content, RTS.Data.get(e, "type_id"))
        used = used + RTS.Data.get(d, "population")
        if RTS.Data.get(e, "construction") == void do cap = cap + RTS.Data.get(d, "supply") end
        queue = RTS.Data.get(e, "queue")
        while queue != [] do
          recipe = RTS.World.definition(content, RTS.Data.get(List.first(queue), "recipe_id"))
          reserved = reserved + RTS.Data.get(RTS.World.definition(content, RTS.Data.get(recipe, "output")), "population")
          queue = List.next(queue)
        end
      end
      entities = List.next(entities)
    end
    %{"used" => used, "reserved" => reserved, "cap" => if cap > RTS.Content.rule(content, "population_cap") do RTS.Content.rule(content, "population_cap") else cap end}
  }
  def refresh = fn (content, state) {
    RTS.Data.put(state, "players", List.map(RTS.Data.get(state, "players"), fn (p) {
      RTS.Data.put(p, "population", RTS.World.population(content, state, RTS.Data.get(p, "slot")))
    }))
  }
  def count = fn (state) {
    total = List.length(RTS.Data.get(state, "entities"))
    entities = RTS.Data.get(state, "entities")
    while entities != [] do
      total = total + List.length(RTS.Data.get(List.first(entities), "queue"))
      entities = List.next(entities)
    end
    total
  }
  def command = fn (content, state, slot, command) {
    plain = type(state) != RTS.Shared
    state = RTS.World.pack(state)
    kind = RTS.Data.get(command, "type")
    result = if List.has?(["move", "stop"], kind) do RTS.Navigation.command(content, state, slot, command) else
      if List.has?(["gather", "deliver", "work", "repair"], kind) do RTS.Economy.command(content, state, slot, command) else
        RTS.Production.command(content, state, slot, command)
      end
    end
    if RTS.Data.get(result, "accepted") do
      updated = RTS.Data.get(result, "state")
      navigation = RTS.Data.get(updated, "navigation")
      pending_id = RTS.Data.get(navigation, "entity_id")
      if pending_id > 0 &&
         RTS.Data.get(RTS.World.find(state, pending_id), "order") != RTS.Data.get(RTS.World.find(updated, pending_id), "order") do
        updated = RTS.Data.put(updated, "navigation", RTS.Data.merge(navigation, %{"search" => void, "entity_id" => 0}))
      end
      updated = RTS.Map.cache(content, RTS.World.refresh(content, updated))
      result = RTS.World.result(RTS.Data.put(updated, "revision", RTS.Data.get(state, "revision") + 1), void)
    end
    if plain do RTS.Data.put(result, "state", RTS.World.unpack(RTS.Data.get(result, "state"))) else result end
  }
  def tick = fn (content, state) {
    plain = type(state) != RTS.Shared
    state = RTS.World.pack(state)
    before = RTS.Data.get(state, "entities")
    alive = List.map_filter(before, e, do if RTS.Data.get(e, "hp") > 0 do e else void end end)
    state = RTS.Data.put(state, "entities", alive)
    if List.length(alive) != List.length(before) do state = RTS.World.refresh(content, state) end
    state = RTS.Navigation.tick(content, state)
    state = RTS.Economy.tick(content, state)
    state = RTS.Production.tick(content, state)
    state = RTS.Map.cache(content, state)
    state = RTS.Data.merge(state, %{"tick" => RTS.Data.get(state, "tick") + 1, "revision" => RTS.Data.get(state, "revision") + 1})
    if plain do RTS.World.unpack(state) else state end
  }
end
