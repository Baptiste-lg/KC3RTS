require JSON
require SHA256

# The pinned JSON writer has no List support and uses KC3 string escapes.
# Encode canonical integer-only JSON here; keep the runtime's parser.
defmodule RTS.Wire do
  def string = fn (value) {
    if Str.has_reserved_characters?(value) do RTS.Wire.escaped_string(value)
    else "\"" + value + "\"" end
  }
  def escaped_string = fn (value) {
    parts = []
    i = 0
    hex = "0123456789abcdef"
    while i < Str.size(value) do
      c = Str.byte(value, i)
      part = Str.slice(value, i, i + 1)
      if c < 32 do
        high = c / 16
        low = c mod 16
        part = "\\u00" + Str.slice(hex, high, high + 1) + Str.slice(hex, low, low + 1)
      else
        if c == 34 || c == 92 do part = "\\" + part end
      end
      parts = [part | parts]
      i = i + 1
    end
    "\"" + List.join(List.reverse(parts), "") + "\""
  }
  def encode = fn (value) {
    if type(value) == Map do
      "{" + List.map_join(Map.keys(value), key, ",", do
        RTS.Wire.string(key) + ":" + RTS.Wire.encode(RTS.Data.get(value, key))
      end) + "}"
    else
      if type(value) == List do
        "[" + List.map_join(value, item, ",", do RTS.Wire.encode(item) end) + "]"
      else
        if type(value) == Str do
          RTS.Wire.string(value)
        else
          if type(value) == Bool || type(value) == Void ||
             RTS.Data.integer?(value, -9007199254740991, 9007199254740991) do
            JSON.to_str(value)
          else
            exit(2)
          end
        end
      end
    end
  }
  def hash = fn (value) { SHA256.str_to_hex(RTS.Wire.encode(value)) }
end
