load!(__DIR__ + "check.kc3")
load!(__DIR__ + "../load.kc3")
RTS.Loader.world(__DIR__ + "../")
content = RTS.Content.compile(RTS.Core.catalog())
world = RTS.World.opening(content, "economy-test", 1234, ["kiln.concord", "lantern.synod"])
RTS.Check.that("opening exposes finite resource nodes", RTS.Data.list?(RTS.Data.get(world, "nodes"), 128))
RTS.Check.that("worker has empty cargo", RTS.Data.get(RTS.Data.find(RTS.Data.get(world, "entities"), "id", 2), "cargo") == void)
load!(__DIR__ + "scenario.kc3")
# Place two workers beside a single finite food node and beside their hall.
world = Map.put(world, "nodes", [%{"id" => 39, "resource_id" => "core.food", "x" => -3584, "z" => -1536, "amount" => 1}])
world = RTS.Scenario.change(world, 2, %{"x" => -3584, "z" => -512})
world = RTS.Scenario.change(world, 3, %{"x" => -3584, "z" => -512})
gather = %{"type" => "gather", "entity_ids" => [2, 3], "target_kind" => "node", "target_id" => 39}
RTS.Scenario.reject(content, world, Map.put(gather, "entity_ids", [2, 9]), "invalid_selection")
RTS.Scenario.reject(content, world, Map.put(gather, "entity_ids", [7]), "invalid_selection")
RTS.Scenario.reject(content, world, Map.put(gather, "target_id", 999), "invalid_target")
working = RTS.Scenario.command(content, world, gather)
working = RTS.Scenario.ticks(content, working, 12)
RTS.Check.that("two workers cannot overspend one node", RTS.Data.get(List.first(RTS.Data.get(working, "nodes")), "amount") == 0)
RTS.Check.that("depletion returns partial cargo exactly once", RTS.Scenario.stock(working, "core.food") == 201 && RTS.Data.get(RTS.World.find(working, 2), "cargo") == void && RTS.Data.get(RTS.World.find(working, 3), "cargo") == void)
RTS.Check.that("exhausted workers become idle", RTS.Data.get(RTS.World.find(working, 2), "task") == void && RTS.Data.get(RTS.World.find(working, 3), "task") == void)
RTS.Check.that("depletion opens the resource cell", RTS.Data.get(RTS.Map.occupied(content, working), "38") != true)
# Stop retains cargo; a different resource may not convert it.
carrying = RTS.Scenario.change(world, 2, %{"cargo" => %{"resource_id" => "core.wood", "amount" => 7}})
RTS.Scenario.reject(content, carrying, Map.put(gather, "entity_ids", [2]), "cargo_mismatch")
stopped = RTS.Scenario.command(content, carrying, %{"type" => "stop", "entity_ids" => [2]})
RTS.Check.that("stop retains resource kind and amount", RTS.Data.get(RTS.World.find(stopped, 2), "cargo") == %{"resource_id" => "core.wood", "amount" => 7})
returned = RTS.Scenario.command(content, stopped, %{"type" => "deliver", "entity_ids" => [2]})
returned = RTS.World.tick(content, returned)
RTS.Check.that("manual delivery transfers cargo once", RTS.Scenario.stock(returned, "core.wood") == 207 && RTS.Data.get(RTS.World.find(returned, 2), "cargo") == void)
RTS.Scenario.reject(content, returned, %{"type" => "deliver", "entity_ids" => [2]}, "empty_cargo")
# Destroyed storage cannot silently consume or credit cargo.
no_depot = RTS.World.remove(carrying, 1)
no_depot = RTS.Scenario.command(content, no_depot, %{"type" => "deliver", "entity_ids" => [2]})
no_depot = RTS.Scenario.ticks(content, no_depot, 12)
RTS.Check.that("no depot preserves cargo and reports reason", RTS.Data.get(RTS.World.find(no_depot, 2), "status") == "no_depot" && RTS.Data.get(RTS.Data.get(RTS.World.find(no_depot, 2), "cargo"), "amount") == 7 && RTS.Scenario.stock(no_depot, "core.wood") == 200)
# Stock caps preserve overflow in cargo instead of destroying resources.
full = RTS.World.balance(carrying, 1, %{"core.wood" => 999798}, 1)
full = RTS.Scenario.command(content, full, %{"type" => "deliver", "entity_ids" => [2]})
full = RTS.World.tick(content, full)
RTS.Check.that("stock cap leaves overflow aboard", RTS.Scenario.stock(full, "core.wood") == 1000000 && RTS.Data.get(RTS.Data.get(RTS.World.find(full, 2), "cargo"), "amount") == 5 && RTS.Data.get(RTS.World.find(full, 2), "status") == "storage_full")
# Farms require an assigned worker, never passive income, and allow one farmer.
farm = RTS.Scenario.add(content, world, "core.farm", -2560, -512)
farm = RTS.Scenario.ticks(content, farm, 20)
RTS.Check.that("unused farm creates no food", RTS.Scenario.stock(farm, "core.food") == 200)
command = %{"type" => "gather", "entity_ids" => [2], "target_kind" => "farm", "target_id" => 15}
farm = RTS.Scenario.command(content, farm, command)
RTS.Scenario.reject(content, farm, Map.put(command, "entity_ids", [3]), "farm_busy")
farm = RTS.Scenario.ticks(content, farm, 100)
RTS.Check.that("farm integer accumulator yields exactly seven", RTS.Data.get(RTS.Data.get(RTS.World.find(farm, 2), "cargo"), "amount") == 7)
farm = RTS.Scenario.command(content, farm, %{"type" => "stop", "entity_ids" => [2]})
farm = RTS.Scenario.command(content, farm, Map.put(command, "entity_ids", [3]))
RTS.Check.that("stopping releases the farm reservation", RTS.Data.get(RTS.Data.get(RTS.World.find(farm, 3), "task"), "target_id") == 15)
# A closer but sealed hall cannot beat a farther reachable depot.
routing = RTS.Scenario.world(content)
routing = RTS.Scenario.add(content, routing, "core.depot", -512, 512)
map = RTS.Data.get(routing, "map")
hall = RTS.World.find(routing, 1)
sealed = RTS.Map.neighbors(map, RTS.Map.cell(map, RTS.Data.get(hall, "x"), RTS.Data.get(hall, "z")))
routing = Map.put(routing, "map", Map.put(map, "blocked", sealed))
nearest = RTS.Navigation.nearest(content, routing, RTS.World.find(routing, 2), RTS.Economy.depots(content, routing, 1, "core.food"))
RTS.Check.that("delivery chooses reachable storage", RTS.Data.get(RTS.Data.get(nearest, "target"), "id") == 15)
# Depleted workers reuse the same generic task for another source of that kind.
reassignment = RTS.Scenario.world(content)
reassignment = RTS.Scenario.change(reassignment, 2, %{"task" => %{"kind" => "gather", "target_kind" => "node", "target_id" => 999,
  "resource_id" => "core.food", "phase" => "gather", "progress" => 0}})
reassignment = RTS.World.tick(content, reassignment)
RTS.Check.that("depletion reassigns the nearest reachable matching resource", RTS.Data.get(RTS.Data.get(RTS.World.find(reassignment, 2), "task"), "target_id") == 39)
# An additional ordinary resource needs only catalog and node data.
catalog = RTS.Core.catalog()
definitions = List.map(RTS.Data.get(catalog, "definitions"), fn (d) {
  if RTS.Data.get(d, "id") == "core.hall" do Map.put(d, "storage", List.append_one(RTS.Data.get(d, "storage"), "test.clay")) else d end
})
catalog = Map.put(catalog, "definitions", List.append_one(definitions, %{"id" => "test.clay", "kind" => "resource", "label" => "Clay", "art" => "core.stone", "category" => "basic", "cap" => 1000, "sources" => ["node"]}))
RTS.Check.that("new gatherable resource validates without handlers", RTS.Content.validate(catalog) == void)
extra = RTS.Content.compile(catalog)
clay = RTS.Scenario.world(extra)
clay = Map.put(clay, "nodes", [%{"id" => 39, "resource_id" => "test.clay", "x" => -3584, "z" => -1536, "amount" => 1}])
clay = RTS.Scenario.change(clay, 2, %{"x" => -3584, "z" => -512})
clay = RTS.Scenario.command(extra, clay, %{"type" => "gather", "entity_ids" => [2], "target_kind" => "node", "target_id" => 39})
clay = RTS.Scenario.ticks(extra, clay, 12)
RTS.Check.that("new resource harvest and delivery conserve its own stock", RTS.Scenario.stock(clay, "test.clay") == 1 && RTS.Scenario.stock(clay, "core.food") == 200 && RTS.Data.get(RTS.World.find(clay, 2), "cargo") == void)
