load!(__DIR__ + "check.kc3")
load!(__DIR__ + "../load.kc3")
RTS.Loader.world(__DIR__ + "../")
grid = %{"width" => 4, "height" => 4, "cell_size" => 256, "origin_x" => -512, "origin_z" => -512, "blocked" => []}
layout = RTS.Map.layout(grid)
mask = RTS.Map.repeat(".", 16)
RTS.Check.that("cover includes each cell of a footprint spanning a corner", RTS.Map.cover(layout, 0, 0, 128) == [5, 6, 9, 10])
RTS.Check.that("cover rejects footprints extending beyond map bounds", RTS.Map.cover(layout, -449, -384, 128) == [] && RTS.Map.cover(layout, -448, -384, 128) == [0])
# Compare the optimized cover with the pre-existing clipped cell enumeration
# and boundary check across varied positions and catalog-sized footprints.
valid = true
List.do([128, 256, 512, 768], size, do
  List.do([-576, -448, -384, -192, -64, 0, 64, 192, 384, 448, 576], x, do
    List.do([-576, -448, -384, -192, -64, 0, 64, 192, 384, 448, 576], z, do
      cells = RTS.Map.cover(layout, x, z, size)
      fits = RTS.Map.fits?(grid, mask, x, z, size)
      valid = valid && ((cells != []) == fits)
      if fits do valid = valid && cells == RTS.Map.cells(grid, x, z, size) end
    end)
  end)
end)
RTS.Check.that("484 footprint cases match the reference geometry", valid)
index = Facts.database()
body = {1, -128, -128, 128}
cells = RTS.Map.cover(layout, -128, -128, 128)
RTS.Spatial.reserve(index, cells, body, true)
RTS.Check.that("an entity ignores its own reservation", RTS.Spatial.clear?(index, cells, body))
RTS.Check.that("touching is allowed but one-unit overlap is rejected",
  RTS.Spatial.available(layout, mask, index, {2, 0, -128, 128}) != [] &&
  RTS.Spatial.available(layout, mask, index, {2, -1, -128, 128}) == [])
RTS.Check.that("different footprints share the same collision rule",
  RTS.Spatial.available(layout, mask, index, {2, 127, -128, 384}) == [] &&
  RTS.Spatial.available(layout, mask, index, {2, 128, -128, 384}) != [])
RTS.Spatial.reserve(index, cells, body, false)
RTS.Check.that("removal immediately releases old cells",
  RTS.Spatial.available(layout, mask, index, {2, -128, -128, 128}) != [])
RTS.Check.that("static terrain still rejects movement through an empty index",
  RTS.Spatial.available(layout, RTS.Map.mark(mask, 5), index, {2, -128, -128, 128}) == [])
content = RTS.Content.compile(RTS.Core.catalog())
unit = RTS.World.entity(content, "kiln.concord", 1, "core.worker", 1, -128, -128, void)
entities = [unit]
spatial = RTS.Spatial.prepare(content, layout, entities)
RTS.Spatial.remember(content, spatial)
saved = Facts.first_with_tags(RTS.Data.get(content, "spatial_cache"), :latest, :spatial, ?, fn (fact) { fact.object })
RTS.Check.that("the cache shares its snapshot instead of copying rows through Facts",
  type(spatial) == RTS.Shared && type(saved) == RTS.Shared)
reused = RTS.Spatial.prepare(content, layout, entities)
RTS.Check.that("unchanged canonical input reuses the derived snapshot", reused == spatial)
RTS.Check.that("the cache is consumed before any mutation",
  Facts.first_with_tags(RTS.Data.get(content, "spatial_cache"), :latest, :spatial, ?, fn (fact) { true }) == void)
RTS.Spatial.remember(content, reused)
changed = [Map.put(unit, "x", 128)]
rebuilt = RTS.Spatial.prepare(content, layout, changed)
rebuilt_index = RTS.Data.get(rebuilt, "index")
RTS.Check.that("restored or changed coordinates invalidate the index",
  RTS.Spatial.available(layout, mask, rebuilt_index, {2, -128, -128, 128}) != [] &&
  RTS.Spatial.available(layout, mask, rebuilt_index, {2, 128, -128, 128}) == [])
RTS.Spatial.remember(content, rebuilt)
empty = RTS.Spatial.prepare(content, layout, [])
RTS.Check.that("removing the last unit invalidates all reservations", RTS.Data.get(empty, "rows") == [] &&
  RTS.Spatial.available(layout, mask, RTS.Data.get(empty, "index"), {2, 128, -128, 128}) != [])
RTS.Spatial.remember(content, spatial)
other_layout = RTS.Map.layout(Map.put(grid, "origin_x", -768))
shifted = RTS.Spatial.prepare(content, other_layout, entities)
RTS.Check.that("changing the grid layout rebuilds cell reservations",
  RTS.Spatial.available(other_layout, mask, RTS.Data.get(shifted, "index"), {2, -128, -128, 128}) == [])
RTS.Spatial.remember(content, spatial)
ordered = [Map.put(unit, "status", "planning")]
updated_spatial = RTS.Spatial.prepare(content, layout, ordered)
updated_rows = RTS.Data.get(updated_spatial, "rows")
{updated, speed, body, covered} = List.first(updated_rows)
RTS.Check.that("non-geometric changes cannot restore stale entity rows", RTS.Data.get(updated, "status") == "planning")
