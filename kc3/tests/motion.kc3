load!(__DIR__ + "check.kc3")
load!(__DIR__ + "../load.kc3")
RTS.Loader.world(__DIR__ + "../")
load!(__DIR__ + "navigation_reference.kc3")
valid = true
cases = 0
List.do([{4, 4, -512, -512, 256}, {7, 3, 5, -9, 7}, {1, 1, 0, 0, 1},
  {65535, 65535, -2147483648, 2147483647, 2147483647}], layout, do
  {width, height, ox, oz, cell_size} = ^ layout
  List.do([-2147483648, -1, 0, 1, 2147483647], x, do
    List.do([-2147483648, 0, 2147483647], z, do
      List.do([0, 1, 64, 2147483647], speed, do
        List.do([0, width - 1, width * (height - 1)], cell, do
          if cell <= 2147483647 do
            List.do([true, false], horizontal_first, do
              body = {9007199254740991, x, z, 1024}
              expected = RTS.NavigationReference.propose(layout, body, speed, cell, horizontal_first)
              actual = RTS.Navigation.propose_native(layout, body, speed, cell, horizontal_first)
              {{actual_id, actual_x, actual_z, actual_size}, actual_reached} = ^ actual
              {{expected_id, expected_x, expected_z, expected_size}, expected_reached} = ^ expected
              valid = valid && actual == expected && RTS.Navigation.propose(layout, body, speed, cell, horizontal_first) == expected &&
                RTS.Wire.encode([actual_id, actual_x, actual_z, actual_size, actual_reached]) ==
                  RTS.Wire.encode([expected_id, expected_x, expected_z, expected_size, expected_reached])
              cases = cases + 1
            end)
          end
        end)
      end)
    end)
  end)
end)
RTS.Check.that("1320 native proposals preserve signed extremes, wide intermediates and canonical encoding", valid && cases == 1320)
List.do([(S8) 1, (S16) 1, (S32) 1, (S64) 1, (Sw) 1,
  (U8) 1, (U16) 1, (U32) 1, (U64) 1, (Uw) 1], one, do
  layout = {one, one, one, one, one}
  body = {18446744073709551616, one, one, %{"opaque" => 1}}
  RTS.Check.that("native motion accepts all bounded integer tags and preserves opaque metadata",
    RTS.Navigation.propose_native(layout, body, one, 0, true) == {body, true})
end)
layout = {4, 4, 0, 0, 256}
body = {1, 128, 128, 128}
List.do([{void, body, 64, 1, true}, {{4, 4}, body, 64, 1, true},
  {layout, [1, 128, 128, 128], 64, 1, true}, {layout, {1, 128}, 64, 1, true},
  {{0, 4, 0, 0, 256}, body, 64, 1, true}, {{4, -1, 0, 0, 256}, body, 64, 1, true},
  {{65536, 4, 0, 0, 256}, body, 64, 1, true}, {{4, 65536, 0, 0, 256}, body, 64, 1, true},
  {{4, 4, 0, 0, 0}, body, 64, 1, true}, {{4, 4, 0, 0, -1}, body, 64, 1, true},
  {{4, 4, 2147483648, 0, 256}, body, 64, 1, true},
  {layout, {1, -2147483649, 128, 128}, 64, 1, true},
  {layout, {1, 128, 2147483648, 128}, 64, 1, true},
  {layout, {1, 0.5, 128, 128}, 64, 1, true},
  {layout, {1, 128, false, 128}, 64, 1, true},
  {{"4", 4, 0, 0, 256}, body, 64, 1, true},
  {{4, 4, 0, 0, 2147483648}, body, 64, 1, true},
  {layout, {1, (U64) 18446744073709551615, 128, 128}, 64, 1, true},
  {layout, {1, 128, (S64) -9223372036854775808, 128}, 64, 1, true},
  {layout, body, -1, 1, true}, {layout, body, 2147483648, 1, true},
  {layout, body, 0.5, 1, true}, {layout, body, true, 1, true},
  {layout, body, (U64) 18446744073709551615, 1, true},
  {layout, body, 64, -1, true}, {layout, body, 64, 16, true},
  {layout, body, 64, 0.5, true}, {layout, body, 64, 1, 1},
  {layout, body, 64, 1, void}, {layout, body, 64, 2147483648, true}],
  {geometry, unit, speed, cell, horizontal_first}, do
  RTS.Check.that("native motion declines unsupported inputs without coercion",
    RTS.Navigation.propose_native(geometry, unit, speed, cell, horizontal_first) == void)
end)
List.do([{{4, 4, -9007199254730000, 9007199254730000, 256},
    {1, -9007199254729872, 9007199254730128, 128}, 64, 5},
  {{65535, 65535, 0, 0, 1}, body, 64, 4294836224},
  {layout, body, 2147483648, 1}, {layout, {1, -2147483649, 128, 128}, 64, 1}],
  {geometry, unit, speed, cell}, do
  List.do([true, false], horizontal_first, do
    RTS.Check.that("unsupported valid geometry retains the exact KC3 fallback",
      RTS.Navigation.propose_native(geometry, unit, speed, cell, horizontal_first) == void &&
      RTS.Navigation.propose(geometry, unit, speed, cell, horizontal_first) ==
        RTS.NavigationReference.propose(geometry, unit, speed, cell, horizontal_first))
  end)
end)
