load!(__DIR__ + "check.kc3")
load!(__DIR__ + "../load.kc3")
RTS.Loader.world(__DIR__ + "../")
load!(__DIR__ + "scenario.kc3")
content = RTS.Content.compile(RTS.Core.catalog())
world = RTS.Scenario.world(content)
RTS.Check.that("deterministic complete opening", world == RTS.Scenario.world(content))
RTS.Check.that("opening follows the economy table", RTS.Scenario.stock(world, "core.food") == 200 && RTS.Scenario.stock(world, "core.wood") == 200 && RTS.Data.get(RTS.World.player(world, 1), "population") == %{"used" => 6, "reserved" => 0, "cap" => 10})
RTS.Check.that("worker and hall production use prescribed ticks", RTS.Data.get(RTS.World.definition(content, "core.train_worker"), "ticks") == 150 && RTS.Data.get(RTS.World.definition(content, "core.build_hall"), "ticks") == 600)
RTS.Check.that("state round trips canonical JSON", JSON.from_str(RTS.Wire.encode(world)) == world)
RTS.Check.that("outcome remains explicit pending combat", RTS.Data.get(RTS.Data.get(world, "outcome"), "status") == "ongoing")
train = %{"type" => "produce", "entity_id" => 1, "recipe_id" => "core.train_worker", "x" => 0, "z" => 0}
RTS.Scenario.reject(content, world, Map.put(train, "entity_id", 8), "invalid_producer")
RTS.Scenario.reject(content, world, Map.put(train, "recipe_id", "missing.recipe"), "unknown_content")
load!(__DIR__ + "extension.kc3")
extended = RTS.Content.compile(RTS.Scenario.fast(RTS.Extension.catalog()))
custom = RTS.World.opening(extended, "extension", 1234, ["test.faction", "kiln.concord"])
custom = RTS.Scenario.command(extended, custom, Map.put(train, "recipe_id", "test.train_worker"))
RTS.Check.that("extension queues pay a specialist resource through shared logic", RTS.Scenario.stock(custom, "test.skyglass") == 15 && List.length(RTS.Data.get(custom, "entities")) == 8)
custom = RTS.Scenario.ticks(extended, custom, 4)
RTS.Check.that("extension spawn applies faction max HP without mutating definition", RTS.Data.get(List.last(RTS.Data.get(custom, "entities")), "max_hp") == 90 && RTS.Data.get(RTS.World.definition(extended, "test.worker"), "hp") == 50)
