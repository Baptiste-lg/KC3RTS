dlopen("kc3rts.so")
load!(__DIR__ + "check.kc3")
load!(__DIR__ + "../rts/data.kc3")
load!(__DIR__ + "../rts/wire.kc3")

RTS.Check.that("zip pairs heterogeneous values in order, including null and false",
  RTS.Data.zip([0, false, void], ["a", %{"x" => 1}, [2]]) ==
    [{0, "a"}, {false, %{"x" => 1}}, {void, [2]}] && RTS.Data.zip([], []) == [])
List.do([{[1], []}, {[], [1]}, {[1, 2], [3]}, {[1], [2, 3]},
         {[1 | 2], [3]}, {[1], [2 | 3]}, {void, []}, {[], 42}], pair, do
  {left, right} = ^ pair
  RTS.Check.that("zip rejects unequal, improper and non-list inputs",
    RTS.Data.zip(left, right) == void)
end)
left = [%{"nested" => [1, 2]}]
right = [RTS.Data.share(%{"nested" => [3, 4]})]
paired = RTS.Data.zip(left, right)
RTS.Check.that("zip leaves both input lists intact",
  left == [%{"nested" => [1, 2]}] && RTS.Data.get(List.first(right), "nested") == [3, 4])
left = void
right = void
{first, second} = List.first(paired)
RTS.Check.that("zip owns nested and shared values after inputs are released",
  RTS.Data.get(first, "nested") == [1, 2] && RTS.Data.get(second, "nested") == [3, 4])

RTS.Check.that("integer bounds exclude floats and bools",
  RTS.Data.integer?(2147483646, 1, 2147483646) &&
  (! RTS.Data.integer?(1.0, 0, 10)) && (! RTS.Data.integer?(true, 0, 10)))
RTS.Check.that("Park Miller arithmetic does not overflow",
  RTS.Data.random_next(1) == 48271 &&
  RTS.Data.random_next(48271) == 182605794 &&
  RTS.Data.random_next(2147483646) == 2147435376)
RTS.Check.that("namespaced ids reject invalid bytes",
  RTS.Data.id?("kiln.worker") && (! RTS.Data.id?("../worker")) &&
  (! RTS.Data.id?("")) && (! RTS.Data.id?("worker name")))
RTS.Check.that("canonical nested maps and arrays",
  RTS.Wire.encode(%{"z" => [1, true, void], "a" => %{"b" => 2}}) ==
    "{\"a\":{\"b\":2},\"z\":[1,true,null]}")
RTS.Check.that("JSON strings escape control bytes and preserve Unicode",
  RTS.Wire.encode("é\n\t\"\\" + (Str) (Character) 1) ==
    "\"é\\u000a\\u0009\\\"\\\\\\u0001\"")
RTS.Check.that("SHA256 canonical known vector",
  RTS.Wire.hash(%{}) == "44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a")
RTS.Check.that("map insertion order does not change hash",
  RTS.Wire.hash(Map.put(%{"z" => 1}, "a", 2)) ==
  RTS.Wire.hash(Map.put(%{"a" => 2}, "z", 1)))

RTS.Check.that("negation is explicitly grouped before conjunction", (! false) && true)
RTS.Check.that("native list selection returns callback values",
  RTS.Data.find([%{"id" => 1}], "id", 1) == %{"id" => 1} &&
  RTS.Data.find([], "id", 1) == void)
RTS.Check.that("plain Unicode string fast path", RTS.Wire.encode("Éclat") == "\"Éclat\"")
# Compiled definitions are shared immutable values, never copies per lookup.
shared = RTS.Data.share(%{"id" => "test.unit", "hp" => 40})
RTS.Check.that("shared definitions keep map lookup semantics", RTS.Data.get(shared, "hp") == 40 && RTS.Data.get(shared, "missing") == void)
RTS.Check.that("shared values retain exact maps", RTS.Data.unshare(shared) == %{"id" => "test.unit", "hp" => 40})
RTS.Check.that("shared wrapping is idempotent", RTS.Data.share(shared) == shared)
RTS.Check.that("missing and non-map reads are void", RTS.Data.get(%{}, "absent") == void && RTS.Data.get(void, "x") == void && RTS.Data.get(42, "x") == void)
nested = RTS.Data.share(%{"array" => [1, %{"x" => 2}], "empty" => void})
slot = RTS.Data.slot()
alias = ^ slot
other_slot = RTS.Data.slot()
RTS.Check.that("slots start empty and own one replaceable value",
  RTS.Data.slot_take(slot) == void && RTS.Data.slot_put(slot, [1, %{"x" => 2}]) == true &&
  RTS.Data.slot_put(slot, nested) == true)
RTS.Check.that("slot aliases share storage but separate instances are isolated",
  RTS.Data.slot_take(other_slot) == void && RTS.Data.slot_take(alias) == nested &&
  RTS.Data.slot_take(slot) == void)
RTS.Data.slot_put(slot, %{"items" => [%{"x" => 3}]})
taken = RTS.Data.slot_take(slot)
RTS.Data.slot_put(slot, false)
slot = void
alias = void
RTS.Check.that("taken values survive overwriting and releasing their source slot",
  taken == %{"items" => [%{"x" => 3}]})
List.do([void, false, 0, [], nested], value, do
  RTS.Data.slot_put(other_slot, value)
  RTS.Check.that("slots preserve exact values and consume them once",
    RTS.Data.slot_take(other_slot) == value && RTS.Data.slot_take(other_slot) == void)
end)
RTS.Check.that("slot operations reject other storage and cannot enter wire state",
  RTS.Data.slot_put(nested, 1) == void && RTS.Data.slot_take(%{}) == void &&
  RTS.Wire.native_encode(other_slot) == void)
comparands = [void, 42, %{}, %{"value" => void}, %{"value" => false},
  %{"value" => 0}, %{"value" => (U32) 1}, %{"value" => (S64) 1},
  %{"value" => []}, %{"value" => [1, 2]}, %{"value" => [2, 1]},
  %{"value" => [1 | 42]}, %{"value" => [%{"x" => 2}]},
  RTS.Data.share(%{"value" => [%{"x" => 2}]}),
  RTS.Data.share(%{"value" => [shared]})]
equal = true
List.do(comparands, left, do
  List.do(comparands, right, do
    equal = equal && (RTS.Data.field_equal?(left, right, "value") ==
      (RTS.Data.get(left, "value") == RTS.Data.get(right, "value")))
  end)
end)
RTS.Check.that("field equality matches 225 ordinary comparisons including missing and nested values", equal)
RTS.Check.that("field equality accepts non-string map keys",
  RTS.Data.field_equal?(%{:key => [1]}, RTS.Data.share(%{:key => [1]}), :key))
RTS.Check.that("field equality does not mutate either source",
  RTS.Data.field_equal?(nested, nested, "array") &&
  RTS.Data.get(nested, "array") == [1, %{"x" => 2}])
RTS.Check.that("native accessor copies nested values with canonical semantics", RTS.Data.get(nested, "array") == [1, %{"x" => 2}] && RTS.Data.get(nested, "empty") == void)
List.do([%{"items" => [0, 1, 2]}, RTS.Data.share(%{"items" => [0, 1, 2]})], source, do
  RTS.Check.that("list-field head agrees with the reference without changing its source",
    RTS.Data.first(source, "items") == List.first(RTS.Data.get(source, "items")) &&
    RTS.Data.rest(source, "items") == List.next(RTS.Data.get(source, "items")) &&
    RTS.Data.get(source, "items") == [0, 1, 2])
end)
List.do([void, 42, %{}, %{"items" => []}, %{"items" => "not a list"}, RTS.Data.share(%{"items" => []})], source, do
  RTS.Check.that("missing empty and non-list field heads are void", RTS.Data.first(source, "items") == void)
end)
source = RTS.Data.share(%{"items" => [%{"value" => 1}, 2]})
head = RTS.Data.first(source, "items")
source = void
RTS.Check.that("list-field heads own their nested result after the source is released",
  RTS.Data.put(head, "value", 3) == %{"value" => 3} && head == %{"value" => 1})
RTS.Check.that("list-field heads preserve false and null values",
  RTS.Data.first(%{"items" => [false, true]}, "items") == false &&
  RTS.Data.first(%{"items" => [void, 1]}, "items") == void)
RTS.Check.that("list-field tails handle empty singleton missing and non-list values",
  RTS.Data.rest(%{"items" => []}, "items") == [] &&
  RTS.Data.rest(RTS.Data.share(%{"items" => [1]}), "items") == [] &&
  RTS.Data.rest(void, "items") == void && RTS.Data.rest(%{}, "items") == void &&
  RTS.Data.rest(%{"items" => 42}, "items") == void)
source = RTS.Data.share(%{"items" => [0, %{"value" => 1}, 2]})
rest = RTS.Data.rest(source, "items")
source = void
RTS.Check.that("list-field tails own nested results after the source is released",
  rest == [%{"value" => 1}, 2] && RTS.Data.put(List.first(rest), "value", 3) == %{"value" => 3})
RTS.Check.that("list-field access preserves shared nested values and dotted tails",
  RTS.Data.first(%{"items" => [shared]}, "items") == shared &&
  RTS.Data.rest(%{"items" => [1 | 42]}, "items") == 42)
samples = [void, false, true, 0, -9007199254740991, 9007199254740991, "Échoppe\n\u0000", [1, %{"z" => [], "a" => [false, void]}]]
List.do(samples, sample, do RTS.Check.that("native codec matches reference bytes", RTS.Wire.native_encode(sample) == RTS.Wire.reference_encode(sample)) end)
RTS.Check.that("native codec rejects unsupported or unsafe types", RTS.Wire.native_encode(1.5) == void && RTS.Wire.native_encode(9007199254740992) == void && RTS.Wire.native_encode(-9007199254740992) == void && RTS.Wire.native_encode(:symbol) == void && RTS.Wire.native_encode(%{symbol: 1}) == void)
large = "x"
i = 0
while i < 22 do large = large + large; i = i + 1 end
RTS.Check.that("native codec bounds allocation while supporting large catalogs", RTS.Wire.native_encode(large) == void && Str.size(RTS.Wire.native_encode(Str.slice(large, 0, 4194302))) == 4194304)
deep = []
i = 0
while i < 66 do deep = [deep]; i = i + 1 end
RTS.Check.that("native codec bounds recursion", RTS.Wire.native_encode(deep) == void)
changed = RTS.Data.put(shared, "hp", 70)
merged = RTS.Data.merge(shared, %{"hp" => 80, "new" => [1, 2]})
RTS.Check.that("shared updates preserve previous values and ownership", RTS.Data.get(shared, "hp") == 40 && RTS.Data.get(changed, "hp") == 70 && RTS.Data.get(merged, "hp") == 80 && RTS.Data.get(merged, "new") == [1, 2])
RTS.Check.that("shared and plain updates have identical values", RTS.Data.unshare(merged) == Map.merge(RTS.Data.unshare(shared), %{"hp" => 80, "new" => [1, 2]}))
RTS.Check.that("shared storage has the same canonical wire representation",
  RTS.Wire.native_encode(%{"nested" => [shared, nested]}) ==
  RTS.Wire.reference_encode(%{"nested" => [RTS.Data.unshare(shared), RTS.Data.unshare(nested)]}))
