load!(__DIR__ + "check.kc3")
load!(__DIR__ + "../load.kc3")
RTS.Loader.world(__DIR__ + "../")
load!(__DIR__ + "scenario.kc3")
content = RTS.Content.compile(RTS.Scenario.fast(RTS.Core.catalog()))
world = RTS.Scenario.change(RTS.Scenario.world(content), 2, %{"x" => -1536, "z" => 512})
build = %{"type" => "produce", "entity_id" => 2, "recipe_id" => "core.build_house", "x" => -2560, "z" => 512}
RTS.Scenario.reject(content, world, Map.merge(build, %{"x" => -3584}), "invalid_location")
RTS.Scenario.reject(content, world, Map.merge(build, %{"x" => -3584, "z" => -1536}), "invalid_location")
RTS.Scenario.reject(content, world, Map.put(build, "x", 99999), "invalid_location")
RTS.Scenario.reject(content, world, Map.put(build, "entity_id", 9), "invalid_producer")
RTS.Scenario.reject(content, world, Map.put(build, "recipe_id", "core.build_hall"), "insufficient_resources")
foundation = RTS.Scenario.command(content, world, build)
RTS.Check.that("foundation reserves its footprint, cost and stable ID", RTS.Data.get(RTS.World.find(foundation, 15), "hp") == 1 && RTS.Scenario.stock(foundation, "core.wood") == 160 && RTS.Data.get(RTS.Map.occupied(content, foundation), "63") == true)
RTS.Check.that("unfinished house provides no population", RTS.Data.get(RTS.Data.get(RTS.World.player(foundation, 1), "population"), "cap") == 10)
RTS.Scenario.reject(content, foundation, build, "invalid_location")
partial = RTS.Scenario.ticks(content, foundation, 2)
RTS.Check.that("builder advances construction and HP", RTS.Data.get(RTS.Data.get(RTS.World.find(partial, 15), "construction"), "remaining_ticks") == 2 && RTS.Data.get(RTS.World.find(partial, 15), "hp") > 1)
paused = RTS.Scenario.command(content, partial, %{"type" => "stop", "entity_ids" => [2]})
paused = RTS.Scenario.ticks(content, paused, 6)
RTS.Check.that("interrupted construction never builds itself", RTS.World.find(paused, 15) == RTS.World.find(partial, 15))
resumed = RTS.Scenario.command(content, paused, %{"type" => "work", "entity_ids" => [2], "target_id" => 15})
finished = RTS.Scenario.ticks(content, resumed, 2)
RTS.Check.that("resumed work completes and supplies population", RTS.Data.get(RTS.World.find(finished, 15), "construction") == void && RTS.Data.get(RTS.World.find(finished, 15), "hp") == 300 && RTS.Data.get(RTS.Data.get(RTS.World.player(finished, 1), "population"), "cap") == 15)
RTS.Check.that("completion never recharges construction", RTS.Scenario.stock(finished, "core.wood") == 160)
RTS.Scenario.reject(content, finished, %{"type" => "cancel_build", "entity_id" => 15}, "invalid_target")
unbuilt_refund = RTS.Scenario.command(content, foundation, %{"type" => "cancel_build", "entity_id" => 15})
RTS.Check.that("unbuilt cancellation refunds only 75 percent", RTS.World.find(unbuilt_refund, 15) == void && RTS.Scenario.stock(unbuilt_refund, "core.wood") == 190)
refund = RTS.Scenario.command(content, partial, %{"type" => "cancel_build", "entity_id" => 15})
RTS.Check.that("partial cancellation refunds 75 percent of remaining work", RTS.Scenario.stock(refund, "core.wood") == 175)
RTS.Scenario.reject(content, refund, %{"type" => "cancel_build", "entity_id" => 15}, "invalid_producer")
RTS.Check.that("cancelled foundation clears worker on next tick", RTS.Data.get(RTS.World.find(RTS.World.tick(content, refund), 2), "task") == void)
destroyed = RTS.World.tick(content, RTS.Scenario.change(partial, 15, %{"hp" => 0}))
RTS.Check.that("destroyed foundation never refunds", RTS.World.find(destroyed, 15) == void && RTS.Scenario.stock(destroyed, "core.wood") == 160)
# Repair consumes paid wood, and stops without material.
damaged = RTS.Scenario.change(finished, 15, %{"hp" => 100})
repair = %{"type" => "repair", "entity_ids" => [2], "target_id" => 15}
repaired = RTS.Scenario.ticks(content, RTS.Scenario.command(content, damaged, repair), 20)
RTS.Check.that("repair spends wood for exact HP", RTS.Data.get(RTS.World.find(repaired, 15), "hp") == 110 && RTS.Scenario.stock(repaired, "core.wood") == 158)
empty = RTS.World.balance(damaged, 1, %{"core.wood" => 160}, -1)
empty = RTS.Scenario.ticks(content, RTS.Scenario.command(content, empty, repair), 20)
RTS.Check.that("unfunded repair cannot restore HP", RTS.Data.get(RTS.World.find(empty, 15), "hp") == 100 && RTS.Data.get(RTS.World.find(empty, 2), "status") == "insufficient_resources")
RTS.Scenario.reject(content, damaged, Map.put(repair, "target_id", 8), "invalid_target")
RTS.Check.that("rounding favors resource conservation", RTS.Production.refund(%{"core.wood" => 41, "core.gold" => 3}, 50, 100) == %{"core.wood" => 20, "core.gold" => 1})
# Death interrupts work, and multiple live builders complete only once.
orphaned = RTS.World.tick(content, RTS.Scenario.change(foundation, 2, %{"hp" => 0}))
RTS.Check.that("dead builder contributes no progress", RTS.Data.get(RTS.Data.get(RTS.World.find(orphaned, 15), "construction"), "remaining_ticks") == 4 && RTS.Data.get(RTS.Data.get(RTS.World.player(orphaned, 1), "population"), "used") == 5)
team = RTS.Scenario.change(foundation, 3, %{"x" => -1536, "z" => 512})
team = RTS.Scenario.command(content, team, %{"type" => "work", "entity_ids" => [2, 3], "target_id" => 15})
team = RTS.Scenario.ticks(content, team, 3)
RTS.Check.that("multiple builders complete once without duplicate population", RTS.Data.get(RTS.World.find(team, 15), "construction") == void && RTS.Data.get(RTS.Data.get(RTS.World.player(team, 1), "population"), "cap") == 15 && RTS.Scenario.stock(team, "core.wood") == 160)
RTS.Check.that("all builders release completed work", RTS.Data.get(RTS.World.find(team, 2), "task") == void && RTS.Data.get(RTS.World.find(team, 3), "task") == void)
