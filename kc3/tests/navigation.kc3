load!(__DIR__ + "check.kc3")
load!(__DIR__ + "../load.kc3")
RTS.Loader.world(__DIR__ + "../")
load!(__DIR__ + "scenario.kc3")
load!(__DIR__ + "navigation_reference.kc3")
valid = true
proposals_valid = true
List.do([{4, 4, -512, -512, 256}, {7, 3, 5, -9, 7}, {1, 1, 0, 0, 1}], layout, do
  {width, height, ox, oz, cell_size} = ^ layout
  offsets = [0 - cell_size, 0, cell_size / 2, cell_size, cell_size * 2]
  List.do(offsets, dx, do
    List.do(offsets, dz, do
      body = {37, ox + dx, oz + dz, 127}
      List.do([0, width - 1, (height - 1) * width, width * height - 1], cell, do
        List.do([0, 1, 64, 256, 1024], speed, do
          {first, first_reached} = RTS.Navigation.propose(layout, body, speed, cell, true)
          reference = RTS.NavigationReference.propose(layout, body, speed, cell, false)
          proposals_valid = proposals_valid &&
            {first, first_reached} == RTS.NavigationReference.propose(layout, body, speed, cell, true) &&
            RTS.Navigation.propose(layout, body, speed, cell, false) == reference
          {next, reached} = ^ reference
          expected = if next == first do void else reference end
          valid = valid && RTS.Navigation.alternate(layout, body, speed, cell, first) == expected
        end)
      end)
    end)
  end)
end)
RTS.Check.that("1500 alternate proposals preserve distinct moves and reject duplicates", valid)
RTS.Check.that("3000 proposals preserve both axis priorities and exact waypoint arrival", proposals_valid)
# Probe either side of the clamp, including exact arrival, no movement and
# large signed origins. Both coordinates vary independently: completing one
# axis must not report arrival while the other is still off target.
proposals_valid = true
List.do([-9007199254730000, 0, 9007199254730000], origin, do
  edge_layout = {3, 3, origin, 0 - origin, 256}
  List.do([0, 1, 32, 64, 256], speed, do
    deltas = [0 - speed - 1, 0 - speed, 1 - speed, -1, 0, 1, speed - 1, speed, speed + 1]
    List.do(deltas, dx, do
      List.do(deltas, dz, do
        body = {37, origin + 384 - dx, 0 - origin + 384 - dz, 127}
        List.do([true, false], horizontal_first, do
          proposals_valid = proposals_valid &&
            RTS.Navigation.propose(edge_layout, body, speed, 4, horizontal_first) ==
            RTS.NavigationReference.propose(edge_layout, body, speed, 4, horizontal_first)
        end)
      end)
    end)
  end)
end)
RTS.Check.that("2430 clamp-boundary proposals preserve integer coordinates and arrival", proposals_valid)
layout = {4, 4, 0, 0, 256}
mask = RTS.Map.repeat(".", 16)
body = {1, 128, 128, 128}
List.do(RTS.NavigationReference.retry_cases(), {name, cell, blockers}, do
  index = Facts.database()
  RTS.Spatial.reserve(index, [0], body, true)
  List.do(blockers, {id, x, z, size}, do
    RTS.Spatial.reserve(index, RTS.Map.cover(layout, x, z, size), {id, x, z, size}, true)
  end)
  {first, reached} = RTS.Navigation.propose(layout, body, 64, cell, true)
  RTS.Check.that("retry fixture rejects its initial candidate: " + name,
    RTS.Spatial.available(layout, mask, index, first) == [])
  cells = RTS.NavigationReference.retry_distinct(layout, mask, index, body, 64, cell, first)
  RTS.Check.that("retry preserves collision results: " + name,
    cells == RTS.NavigationReference.retry(layout, mask, index, body, 64, cell, first) &&
    (cells != []) == (name == "diagonal_open"))
end)
content = RTS.Content.compile(RTS.Core.catalog())
world = RTS.World.opening(content, "navigation", 1234, ["kiln.concord", "lantern.synod"])
grid = RTS.Map.grid(RTS.Data.get(world, "map"))
# Compare the fused inspection with the previous three passes, including a
# stale order late in the list and a resumed search outranking equal priorities.
prepare_order = Map.merge(RTS.Navigation.order(13, 7),
  %{"path" => [4, 8, 13], "wait" => 19, "attempt" => 1, "priority" => 12})
old_order = Map.put(prepare_order, "revision", 6)
variants = [{void, void}, {"planning", void}, {void, prepare_order},
  {"planning", prepare_order}, {"waiting", prepare_order},
  {void, old_order}, {"waiting", old_order}, {"blocked", old_order}]
prepare_unit = RTS.World.entity(content, "kiln.concord", 9, "core.worker", 1, -128, -128, void)
valid = true
List.do(variants, {status_a, order_a}, do
  List.do(variants, {status_b, order_b}, do
    List.do([0, 2, 9], search_id, do
      trial = %{"entities" => [Map.merge(prepare_unit, %{"status" => status_a, "order" => order_a}),
        Map.merge(prepare_unit, %{"id" => 2, "status" => status_b, "order" => order_b})],
        "navigation" => %{"revision" => 7, "entity_id" => search_id, "search" => %{"sentinel" => 42}},
        "sentinel" => [1, 2, 3]}
      List.do([trial, RTS.World.pack(trial)], input, do
        before = RTS.Wire.encode(input)
        actual = RTS.Navigation.prepare(input)
        valid = valid && actual == RTS.NavigationReference.prepare(input) && RTS.Wire.encode(input) == before
      end)
    end)
  end)
end)
RTS.Check.that("384 order preparations preserve activity, state, priority and input immutability", valid)
trial = %{"entities" => [Map.merge(prepare_unit, %{"status" => "planning", "order" => prepare_order}),
  Map.merge(prepare_unit, %{"id" => 2, "status" => "planning", "order" => prepare_order})],
  "navigation" => %{"revision" => 7, "entity_id" => 0}}
{prepared, active, pending} = RTS.Navigation.prepare(trial)
RTS.Check.that("equal planner priorities retain ascending ID tie-breaking",
  active && prepared == trial && pending == [[-12, 2], [-12, 9]])
trial = Map.put(trial, "navigation", %{"revision" => 7, "entity_id" => 9})
{prepared, active, pending} = RTS.Navigation.prepare(trial)
RTS.Check.that("the in-progress search still precedes higher-ID tie-breaking",
  pending == [[-100000, 9], [-12, 2]])
trial = Map.put(trial, "entities", [Map.merge(prepare_unit, %{"status" => "waiting", "order" => old_order})])
{prepared, active, pending} = RTS.Navigation.prepare(trial)
fresh = RTS.Data.get(List.first(RTS.Data.get(prepared, "entities")), "order")
RTS.Check.that("invalidation clears route and retry counters but preserves goal and priority",
  active && pending == [[-100000, 9]] && RTS.Data.unshare(fresh) ==
    Map.put(RTS.Navigation.order(13, 7), "priority", 12) &&
  RTS.Data.get(List.first(RTS.Data.get(prepared, "entities")), "status") == "planning")
List.do([[], [prepare_unit], [Map.put(prepare_unit, "status", "planning")]], idle_entities, do
  trial = Map.put(trial, "entities", idle_entities)
  RTS.Check.that("empty or idle preparation leaves the state untouched with no jobs",
    RTS.Navigation.prepare(trial) == {trial, false, []})
end)
# A stationary neighbor blocks the same horizontal candidate on both attempts.
# Skipping that duplicate must neither move the unit nor consume extra waits.
retry_actor = RTS.World.entity(content, "kiln.concord", 1, "core.worker", 1, -5504, -3968, void)
retry_blocker = RTS.World.entity(content, "kiln.concord", 2, "core.worker", 1, -5376, -3968, void)
retry_state = RTS.Map.cache(content, Map.merge(world, %{"nodes" => [],
  "map" => Map.put(RTS.Data.get(world, "map"), "blocked", []),
  "entities" => [retry_actor, retry_blocker], "next_entity_id" => 3}))
retry_grid = RTS.Map.grid(RTS.Data.get(retry_state, "map"))
retry_goal = RTS.Map.cell(retry_grid, -5248, -3968)
retry_revision = RTS.Data.get(RTS.Data.get(retry_state, "navigation"), "revision")
List.do([{0, 0, void, 0}, {18, 0, void, 0}, {19, 0, "planning", 1},
  {28, 1, void, 1}, {29, 1, "planning", 1}, {38, 1, void, 1}, {39, 1, "planning", 1},
  {69, 1, "blocked", 1}], {waited, attempt, status, next_attempt}, do
  retry_order = Map.merge(RTS.Navigation.order(retry_goal, retry_revision),
    %{"path" => [retry_goal], "wait" => waited, "attempt" => attempt})
  actor = Map.put(retry_actor, "order", retry_order)
  trial = Map.put(retry_state, "entities", [actor, retry_blocker])
  after = RTS.World.find(RTS.Navigation.tick(content, trial), 1)
  order = RTS.Data.get(after, "order")
  RTS.Check.that("duplicate rejection preserves position, status and input state",
    RTS.Data.get(after, "x") == -5504 && RTS.Data.get(after, "z") == -3968 &&
    RTS.Data.get(after, "status") == status && RTS.World.find(trial, 1) == actor)
  RTS.Check.that("duplicate rejection preserves one wait increment and retry thresholds",
    if status == "blocked" do order == void else
      RTS.Data.get(order, "wait") == waited + 1 && RTS.Data.get(order, "attempt") == next_attempt &&
      RTS.Data.get(order, "path") == if status == "planning" do [] else [retry_goal] end
    end)
end)
centered = RTS.World.entity(content, "kiln.concord", 99, "core.worker", 1, -3712, -3968, void)
RTS.Check.that("route entry retains the nearest cell rather than its distance",
  RTS.Navigation.entry(grid, RTS.Map.repeat(".", 1920), centered) == 201)
retrying = Map.merge(centered, %{"x" => -3776, "order" => Map.merge(RTS.Navigation.order(202, 0),
  %{"path" => [201, 202], "wait" => 25, "attempt" => 1})})
progressed = RTS.Navigation.advance(content, grid, retrying, true)
RTS.Check.that("reaching a detour waypoint restores the retry for a later obstruction",
  RTS.Data.get(RTS.Data.get(progressed, "order"), "attempt") == 0 &&
  RTS.Data.get(RTS.Data.get(progressed, "order"), "wait") == 0)
partial = RTS.World.pack_entity(Map.put(retrying, "x", -3840))
partial_order = RTS.Data.get(partial, "order")
advanced = RTS.Navigation.advance(content, grid, partial, true)
RTS.Check.that("partial movement preserves the complete shared route and retry budget",
  RTS.Data.get(advanced, "x") == -3776 &&
  type(RTS.Data.get(advanced, "order")) == RTS.Shared &&
  RTS.Data.get(advanced, "order") == partial_order &&
  RTS.Data.get(partial, "x") == -3840)
last_waypoint = Map.put(centered, "order", Map.put(RTS.Navigation.order(201, 0), "path", [201]))
RTS.Check.that("the final waypoint removes the order exactly once",
  RTS.Data.get(RTS.Navigation.advance(content, grid, last_waypoint, true), "order") == void)
zero_cell = Map.merge(centered, %{"x" => -6080, "z" => -4992,
  "order" => Map.put(RTS.Navigation.order(0, 0), "path", [0])})
zero_done = RTS.Navigation.advance(content, grid, zero_cell, true)
RTS.Check.that("cell zero is a waypoint rather than an empty path",
  RTS.Data.get(zero_done, "x") == -6016 && RTS.Data.get(zero_done, "order") == void)
empty_route = Map.put(centered, "order", RTS.Navigation.order(201, 0))
RTS.Check.that("an empty route does not move the entity",
  RTS.Navigation.advance(content, grid, empty_route, true) == empty_route)
move = %{"type" => "move", "entity_ids" => [2, 3], "x" => 1536, "z" => 512}
result = RTS.World.command(content, world, 1, move)
RTS.Check.that("owned move accepted", RTS.Data.get(result, "accepted"))
RTS.Check.that("mixed owner rejects atomically", RTS.World.command(content, world, 1,
  Map.put(move, "entity_ids", [2, 9])) == RTS.World.result(world, "invalid_selection"))
RTS.Check.that("building selection rejects", RTS.Data.get(RTS.World.command(content, world, 1,
  Map.put(move, "entity_ids", [1])), "reason") == "invalid_selection")
RTS.Check.that("duplicate selection rejects", RTS.Data.get(RTS.World.command(content, world, 1,
  Map.put(move, "entity_ids", [2, 2])), "reason") == "invalid_selection")
RTS.Check.that("outside map rejects", RTS.Data.get(RTS.World.command(content, world, 1,
  Map.put(move, "x", 99999)), "reason") == "invalid_location")
blocked = List.first(RTS.Data.get(world, "nodes"))
RTS.Check.that("blocked target rejects", RTS.Data.get(RTS.World.command(content, world, 1,
  Map.merge(move, %{"x" => RTS.Data.get(blocked, "x"), "z" => RTS.Data.get(blocked, "z")} )), "reason") == "invalid_location")
moved = RTS.Data.get(result, "state")
initial = RTS.Data.find(RTS.Data.get(moved, "entities"), "id", 2)
moved = RTS.World.tick(content, moved)
RTS.Check.that("KC3 tick moves integer coordinates", RTS.Data.find(RTS.Data.get(moved, "entities"), "id", 2) != initial)
stopped = RTS.Data.get(RTS.World.command(content, moved, 1,
  %{"type" => "stop", "entity_ids" => [2, 3]}), "state")
RTS.Check.that("stop freezes positions", RTS.Data.get(RTS.World.tick(content, stopped), "entities") == RTS.Data.get(stopped, "entities"))
rerouted = RTS.Data.get(result, "state")
occupied = RTS.Map.occupied(content, world)
i = 0
while i < 180 do
  rerouted = RTS.World.tick(content, rerouted)
  RTS.Check.that("route remains off blocked terrain", List.all?(RTS.Data.get(rerouted, "entities"), fn (e) {
    RTS.Data.get(RTS.World.definition(content, RTS.Data.get(e, "type_id")), "kind") == "building" || RTS.Data.get(occupied, (Str) RTS.Map.cell(RTS.Data.get(world, "map"), RTS.Data.get(e, "x"), RTS.Data.get(e, "z"))) != true
  }))
  i = i + 1
end
RTS.Check.that("route completes", RTS.Data.get(RTS.Data.find(RTS.Data.get(rerouted, "entities"), "id", 2), "order") == void)
RTS.Check.that("selection order does not affect simulation", result == RTS.World.command(content, world, 1,
  Map.put(move, "entity_ids", [3, 2])))
sealed = Map.put(world, "map", Map.put(RTS.Data.get(world, "map"), "blocked", [55, 66, 68, 79]))
sealed_result = RTS.World.command(content, sealed, 1, move)
RTS.Check.that("unreachable orders enter bounded planning", RTS.Data.get(sealed_result, "accepted"))
planning = RTS.World.tick(content, RTS.Data.get(sealed_result, "state"))
RTS.Check.that("sealed target leaves an incremental search in progress",
  RTS.Data.get(RTS.Data.get(planning, "navigation"), "entity_id") > 0)
planner_id = RTS.Data.get(RTS.Data.get(planning, "navigation"), "entity_id")
replaced = RTS.Data.get(RTS.World.command(content, planning, 1,
  %{"type" => "move", "entity_ids" => [planner_id], "x" => -1536, "z" => -1536}), "state")
RTS.Check.that("a replacement order discards the old incremental search",
  RTS.Data.get(RTS.Data.get(replaced, "navigation"), "search") == void)
cancelled = RTS.Data.get(RTS.World.command(content, planning, 1,
  %{"type" => "stop", "entity_ids" => [planner_id]}), "state")
RTS.Check.that("stop discards the cancelled incremental search",
  RTS.Data.get(RTS.Data.get(cancelled, "navigation"), "search") == void)
sealed_done = RTS.Scenario.ticks(content, RTS.Data.get(sealed_result, "state"), 30)
RTS.Check.that("unreachable orders terminate with a reason", RTS.Data.get(RTS.World.find(sealed_done, 2), "order") == void && RTS.Data.get(RTS.World.find(sealed_done, 2), "status") == "unreachable")
checkpoint = RTS.Scenario.ticks(content, RTS.Data.get(result, "state"), 5)
packed_checkpoint = RTS.World.pack(checkpoint)
RTS.Check.that("packing shares route maps without changing their canonical value",
  type(RTS.Data.get(RTS.World.find(packed_checkpoint, 2), "order")) == RTS.Shared &&
  RTS.Wire.encode(packed_checkpoint) == RTS.Wire.encode(checkpoint))
shared_command = RTS.World.command(content, RTS.World.pack(world), 1, move)
RTS.Check.that("commands retain shared storage at the worker boundary",
  type(RTS.Data.get(shared_command, "state")) == RTS.Shared &&
  RTS.Wire.encode(shared_command) == RTS.Wire.encode(result))
RTS.Check.that("shared and decoded state advance with identical canonical values",
  RTS.Wire.encode(RTS.World.tick(content, packed_checkpoint)) == RTS.Wire.encode(RTS.World.tick(content, checkpoint)))
RTS.Check.that("a shared tick retains its storage without changing its input",
  type(RTS.World.tick(content, packed_checkpoint)) == RTS.Shared && RTS.World.unpack(packed_checkpoint) == checkpoint)
restored = JSON.from_str(RTS.Wire.encode(checkpoint))
RTS.Check.that("mid-route restoration preserves exact subsequent state", RTS.Scenario.ticks(content, checkpoint, 20) == RTS.Scenario.ticks(content, restored, 20))
RTS.Check.that("navigation leaves the PRNG untouched", RTS.Data.get(rerouted, "rng_state") == RTS.Data.get(world, "rng_state"))
nav_revision = RTS.Data.get(RTS.Data.get(world, "navigation"), "revision")
RTS.Check.that("unchanged walkability reuses its cache", RTS.Map.cache(content, world) == world)
nodes = RTS.Data.get(world, "nodes")
changed = Map.put(world, "nodes", [Map.put(List.first(nodes), "amount", 1) | List.next(nodes)])
RTS.Check.that("partial depletion preserves walkability revision", RTS.Data.get(RTS.Data.get(RTS.Map.cache(content, changed), "navigation"), "revision") == nav_revision)
changed = Map.put(world, "nodes", [Map.put(List.first(nodes), "amount", 0) | List.next(nodes)])
RTS.Check.that("depletion invalidates cached walkability", RTS.Data.get(RTS.Data.get(RTS.Map.cache(content, changed), "navigation"), "revision") == nav_revision + 1)
changed = RTS.World.remove(world, 1)
RTS.Check.that("demolition invalidates cached walkability", RTS.Data.get(RTS.Data.get(RTS.Map.cache(content, changed), "navigation"), "revision") == nav_revision + 1)
changed = Map.put(checkpoint, "map", Map.put(RTS.Data.get(checkpoint, "map"), "blocked", [0]))
cached = RTS.Map.cache(content, changed)
{reference_ready, active, pending} = RTS.NavigationReference.prepare(cached)
RTS.Check.that("terrain invalidation schedules the same orders before the next tick",
  active && pending != [] && RTS.Navigation.prepare(cached) == {reference_ready, active, pending})
RTS.Check.that("a terrain-changing tick agrees with explicitly reset reference orders",
  RTS.Wire.encode(RTS.Navigation.tick(content, changed)) == RTS.Wire.encode(RTS.Navigation.tick(content, reference_ready)))
