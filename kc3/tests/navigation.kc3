load!(__DIR__ + "check.kc3")
load!(__DIR__ + "../load.kc3")
RTS.Loader.world(__DIR__ + "../")
content = RTS.Content.compile(RTS.Core.catalog())
world = RTS.World.opening(content, "navigation", 1234, ["kiln.concord", "lantern.synod"])
move = %{"type" => "move", "entity_ids" => [2, 3], "x" => 1536, "z" => 512}
result = RTS.World.command(content, world, 1, move)
RTS.Check.that("owned move accepted", RTS.Data.get(result, "accepted"))
RTS.Check.that("mixed owner rejects atomically", RTS.World.command(content, world, 1,
  Map.put(move, "entity_ids", [2, 9])) == RTS.World.result(world, "invalid_selection"))
RTS.Check.that("building selection rejects", RTS.Data.get(RTS.World.command(content, world, 1,
  Map.put(move, "entity_ids", [1])), "reason") == "invalid_selection")
RTS.Check.that("duplicate selection rejects", RTS.Data.get(RTS.World.command(content, world, 1,
  Map.put(move, "entity_ids", [2, 2])), "reason") == "invalid_selection")
RTS.Check.that("outside map rejects", RTS.Data.get(RTS.World.command(content, world, 1,
  Map.put(move, "x", 99999)), "reason") == "invalid_location")
blocked = List.first(RTS.Data.get(world, "nodes"))
RTS.Check.that("blocked target rejects", RTS.Data.get(RTS.World.command(content, world, 1,
  Map.merge(move, %{"x" => RTS.Data.get(blocked, "x"), "z" => RTS.Data.get(blocked, "z")} )), "reason") == "invalid_location")
moved = RTS.Data.get(result, "state")
initial = RTS.Data.find(RTS.Data.get(moved, "entities"), "id", 2)
moved = RTS.World.tick(content, moved)
RTS.Check.that("KC3 tick moves integer coordinates", RTS.Data.find(RTS.Data.get(moved, "entities"), "id", 2) != initial)
stopped = RTS.Data.get(RTS.World.command(content, moved, 1,
  %{"type" => "stop", "entity_ids" => [2, 3]}), "state")
RTS.Check.that("stop freezes positions", RTS.Data.get(RTS.World.tick(content, stopped), "entities") == RTS.Data.get(stopped, "entities"))
rerouted = RTS.Data.get(result, "state")
occupied = RTS.Map.occupied(content, world)
i = 0
while i < 180 do
  rerouted = RTS.World.tick(content, rerouted)
  RTS.Check.that("route remains off blocked terrain", List.all?(RTS.Data.get(rerouted, "entities"), fn (e) {
    RTS.Data.get(RTS.World.definition(content, RTS.Data.get(e, "type_id")), "kind") == "building" || RTS.Data.get(occupied, (Str) RTS.Map.cell(RTS.Data.get(world, "map"), RTS.Data.get(e, "x"), RTS.Data.get(e, "z"))) != true
  }))
  i = i + 1
end
RTS.Check.that("route completes", RTS.Data.get(RTS.Data.find(RTS.Data.get(rerouted, "entities"), "id", 2), "order") == void)
RTS.Check.that("selection order does not affect simulation", result == RTS.World.command(content, world, 1,
  Map.put(move, "entity_ids", [3, 2])))
sealed = Map.put(world, "map", Map.put(RTS.Data.get(world, "map"), "blocked", [55, 66, 68, 79]))
RTS.Check.that("unreachable group rejects without mutation", RTS.World.command(content, sealed, 1, move) == RTS.World.result(sealed, "unreachable"))
