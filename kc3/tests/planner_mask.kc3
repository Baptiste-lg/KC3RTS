load!(__DIR__ + "check.kc3")
load!(__DIR__ + "../load.kc3")
RTS.Loader.world(__DIR__ + "../")
load!(__DIR__ + "navigation_reference.kc3")
catalog = RTS.Core.catalog()
definitions = RTS.Data.get(catalog, "definitions")
sizes = [1, 127, 128, 255, 256, 257, 384, 512, 1024]
List.do(sizes, size, do
  definitions = [Map.put(RTS.Core.entity("test.body" + (Str) size, "unit", "Body", 40, ["move"]), "footprint", size) | definitions]
end)
content = RTS.Content.compile(Map.put(catalog, "definitions", definitions))
valid = true
cases = 0
List.do([{8, 8, -1024, -1024, 256}, {7, 3, -21, 14, 7},
  {1, 1, 0, 0, 1}, {4, 5, -9007199254730000, 9007199254730000, 256}], layout, do
  {width, height, ox, oz, cell_size} = ^ layout
  grid = RTS.Data.share(%{"width" => width, "height" => height, "origin_x" => ox,
    "origin_z" => oz, "cell_size" => cell_size})
  open = RTS.Map.repeat(".", width * height)
  # Include self, another owner, buildings, overlapping and off-map neighbors.
  neighbors = [%{"id" => 1, "type_id" => "test.body512", "x" => ox, "z" => oz},
    %{"id" => 2, "type_id" => "core.hall", "x" => ox + 128, "z" => oz + 128},
    %{"id" => 3, "type_id" => "test.body127", "owner" => 2, "x" => ox - 1, "z" => oz + 128},
    %{"id" => 4, "type_id" => "test.body384", "x" => ox + 256, "z" => oz + 256},
    %{"id" => 5, "type_id" => "test.body128", "x" => ox + width * cell_size, "z" => oz + height * cell_size},
    %{"id" => 6, "type_id" => "test.body1", "x" => ox + 128, "z" => oz + 128}]
  List.do(sizes, size, do
    List.do([0, 1], attempt, do
      entity = RTS.Data.share(%{"id" => 1, "type_id" => "test.body" + (Str) size,
        "order" => RTS.Data.share(%{"attempt" => attempt})})
      List.do([open, RTS.Map.mark(RTS.Map.mark(open, 0), width * height - 1), RTS.Map.repeat("#", width * height)], mask, do
        List.do([[], neighbors], entities, do
          state = RTS.Data.share(%{"entities" => entities})
          expected = RTS.NavigationReference.planner_mask(content, state, grid, mask, entity)
          actual = RTS.Navigation.planner_mask(content, state, grid, mask, entity)
          valid = valid && actual == expected && Str.size(actual) == Str.size(mask)
          cases = cases + 1
        end)
      end)
    end)
  end)
end)
RTS.Check.that("432 planner masks preserve terrain, retries, clipping, odd footprints and wide origins",
  valid && cases == 432)

# The historical center plane deliberately leaves tangent centers available.
# Retry graph edges, tested separately, reject crossing BETWEEN these centers.
edge_grid = %{"width" => 8, "height" => 8, "origin_x" => 0, "origin_z" => 0, "cell_size" => 256}
edge_terrain = RTS.Map.repeat(".", 64)
List.do([{128, 128}, {1, 1}, {127, 1}, {128, 127}, {255, 127}], {size, other_size}, do
  entity = %{"id" => 1, "type_id" => "test.body" + (Str) size, "order" => %{"attempt" => 1}}
  List.do([{256, 128, 0, 1}, {257, 128, 0, 1}, {128, 256, 0, 8}, {128, 257, 0, 8}],
    {x, z, first, second}, do
    state = %{"entities" => [%{"id" => 2, "type_id" => "test.body" + (Str) other_size, "x" => x, "z" => z}]}
    before = RTS.Wire.encode(state)
    mask = RTS.Navigation.planner_mask(content, state, edge_grid, edge_terrain, entity)
    graph = RTS.Navigation.graph(RTS.Map.layout(edge_grid), edge_terrain, [{2, x, z, other_size}], size, 1)
    edge = if second == first + 1 do 64 + first else 128 + first end
    RTS.Check.that("retry graphs preserve historical centers and block crossing edges for small and odd bodies",
      Str.slice(graph, 0, 64) == mask && Str.byte(graph, edge) == 35 &&
      mask == RTS.NavigationReference.planner_mask(content, state, edge_grid, edge_terrain, entity) &&
      RTS.Wire.encode(state) == before && edge_terrain == RTS.Map.repeat(".", 64))
    fresh = Map.put(entity, "order", %{"attempt" => 0})
    RTS.Check.that("fresh small-unit planning does not inherit dynamic graph blockers",
      RTS.Navigation.planner_mask(content, state, edge_grid, edge_terrain, fresh) == edge_terrain)
  end)
end)

# Reuse, terrain changes and restored geometry must agree with a fresh scan.
grid = RTS.Data.share(%{"width" => 8, "height" => 8, "origin_x" => -1024, "origin_z" => -1024, "cell_size" => 256})
mask = RTS.Map.repeat(".", 64)
entity = RTS.Data.share(%{"id" => 1, "type_id" => "test.body512", "order" => RTS.Data.share(%{"attempt" => 0})})
state = RTS.Data.share(%{"entities" => []})
valid = true
List.do([{grid, mask, entity}, {grid, mask, entity},
  {grid, RTS.Map.mark(mask, 27), entity}, {grid, mask, entity},
  {RTS.Data.put(grid, "origin_x", 0), mask, entity},
  {RTS.Data.merge(grid, %{"width" => 16, "height" => 4}), mask, entity},
  {RTS.Data.put(grid, "cell_size", 128), mask, entity},
  {grid, mask, RTS.Data.put(entity, "type_id", "test.body257")},
  {grid, mask, entity}], {geometry, terrain, unit}, do
  actual = RTS.Navigation.planner_mask(content, state, geometry, terrain, unit)
  expected = RTS.NavigationReference.planner_mask(content, state, geometry, terrain, unit)
  saved = RTS.Data.slot_take(RTS.Data.get(content, "clearance_cache"))
  valid = valid && actual == expected && RTS.Data.get(saved, "mask") == terrain &&
    RTS.Data.get(saved, "layout") == RTS.Map.layout(geometry) &&
    RTS.Data.get(saved, "size") == RTS.Data.get(RTS.World.definition(content, RTS.Data.get(unit, "type_id")), "footprint") &&
    RTS.Data.get(saved, "clearance") == actual
  RTS.Data.slot_put(RTS.Data.get(content, "clearance_cache"), saved)
end)
RTS.Check.that("one-entry clearance cache follows terrain, footprint and layout changes and restoration", valid)

retry = RTS.Data.put(entity, "order", RTS.Data.share(%{"attempt" => 1}))
valid = true
List.do([0, 256, 512, 256, 0], x, do
  state = RTS.Data.share(%{"entities" => [%{"id" => 2, "type_id" => "test.body128", "x" => x, "z" => 0}]})
  actual = RTS.Navigation.planner_mask(content, state, grid, mask, retry)
  saved = RTS.Data.slot_take(RTS.Data.get(content, "clearance_cache"))
  valid = valid && actual == RTS.NavigationReference.planner_mask(content, state, grid, mask, retry) &&
    RTS.Data.get(saved, "clearance") == RTS.NavigationReference.planner_mask(content, state, grid, mask, entity)
  RTS.Data.slot_put(RTS.Data.get(content, "clearance_cache"), saved)
end)
RTS.Check.that("moving retry blockers never contaminate cached static clearance", valid)
independent = RTS.Content.compile(catalog)
RTS.Check.that("another compiled catalog starts with an independent empty clearance cache",
  RTS.Data.slot_take(RTS.Data.get(independent, "clearance_cache")) == void &&
    RTS.Data.slot_take(RTS.Data.get(content, "clearance_cache")) != void)
