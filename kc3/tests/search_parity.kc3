load!(__DIR__ + "check.kc3")
dlopen("kc3rts.so")
load!(__DIR__ + "../rts/data.kc3")
load!(__DIR__ + "../rts/wire.kc3")
load!(__DIR__ + "../rts/map.kc3")
load!(__DIR__ + "../rts/search.kc3")
load!(__DIR__ + "search_reference.kc3")
defmodule RTS.SearchParity do
  def chunk = fn (map, mask, original, budget) {
    before = inspect(original)
    expected = RTS.SearchReference.run(map, mask, original, budget)
    actual = RTS.Search.run(map, mask, original, budget)
    RTS.Check.that("each search budget preserves the complete state and exact canonical bytes",
      actual == expected && inspect(actual) == inspect(expected) &&
      RTS.Wire.encode(actual) == RTS.Wire.encode(expected) && inspect(original) == before)
    actual
  }
  def scene = fn (map, mask, start, goal, astar, budget) {
    current = RTS.Search.start(map, start, goal, astar)
    steps = 0
    while RTS.Data.get(current, "status") == "planning" && steps < 256 do
      current = RTS.SearchParity.chunk(map, mask, current, budget)
      # Independently serialize and resume every third chunk.
      if steps mod 3 == 0 do current = JSON.from_str(RTS.Wire.encode(current)) end
      steps = steps + 1
    end
    RTS.Check.that("bounded parity scene completes without changing frontier policy",
      RTS.Data.get(current, "status") != "planning")
    current
  }
end
map = %{"width" => 8, "height" => 8, "cell_size" => 256, "origin_x" => 0, "origin_z" => 0, "blocked" => []}
mask = RTS.Map.repeat(".", 64)
List.do([true, false], astar, do
  List.do([{0, 63}, {63, 0}, {0, 56}, {56, 0}], {start, goal}, do
    List.do([1, 3, 17], budget, do
      RTS.SearchParity.scene(map, mask, start, goal, astar, budget)
    end)
  end)
end)

# Small asymmetric fixtures isolate neighbor guards and packed priority ties.
# Keep these boundary cases when experimenting with search helper inlining.
# Four corners and the center exercise every missing/present neighbor axis.
List.do([{1, 1, 0, 0, false},
  {4, 1, 0, 3, false}, {4, 1, 3, 0, true},
  {1, 4, 0, 3, true}, {1, 4, 3, 0, false},
  {3, 3, 0, 8, false}, {3, 3, 2, 6, true},
  {3, 3, 6, 2, false}, {3, 3, 8, 0, true},
  {3, 3, 4, 0, true}, {3, 3, 4, 8, false}],
  {width, height, start, goal, reverse}, do
  tiny = %{"width" => width, "height" => height}
  clear = RTS.Map.repeat(".", width * height)
  RTS.Check.that("corner and single-axis fixtures exercise the intended opposite tie directions",
    RTS.Search.reverse_ties?(tiny, start, goal) == reverse)
  List.do([true, false], astar, do
    current = RTS.Search.start(tiny, start, goal, astar)
    List.do([0, 1, 2], budget, do
      current = RTS.SearchParity.chunk(tiny, clear, current, budget)
      if width == 1 && height == 1 && budget == 1 do
        RTS.Check.that("one-cell search reaches its goal without generating neighbors",
          RTS.Data.get(current, "status") == "ready" &&
          RTS.Data.get(current, "expanded") == 1 && RTS.Data.get(current, "path") == [0])
      end
      current = JSON.from_str(RTS.Wire.encode(current))
    end)
  end)
end)
singleton = %{"width" => 1, "height" => 1}
List.do(["#", "#.."], blocked_goal, do
  List.do([0, 1], budget, do
    stopped = RTS.SearchParity.chunk(singleton, blocked_goal,
      RTS.Search.start(singleton, 0, 0, true), budget)
    RTS.Check.that("blocked one-cell goals win over budget and ready-goal checks in N/3N masks",
      RTS.Data.get(stopped, "status") == "unreachable" && RTS.Data.get(stopped, "expanded") == 0)
  end)
end)
initial = RTS.Search.start(map, 0, 63, true)
RTS.SearchParity.chunk(map, mask, initial, 0)
sealed = RTS.Map.mark(RTS.Map.mark(mask, 1), 8)
RTS.SearchParity.scene(map, sealed, 0, 63, true, 3)
RTS.SearchParity.chunk(map, RTS.Map.mark(mask, 63), initial, 8)
# The public protocol accepts an unsorted resumed frontier. Keep its first pop
# and stale-priority behavior; only fall back to full sort at the old sort site.
partial = RTS.SearchReference.run(map, mask, initial, 3)
open = RTS.Data.get(partial, "open")
List.do([List.reverse(open), List.append(open, open),
  [RTS.Search.priority(map, 0, 7, 14, false) | open]], restored_open, do
  restored = RTS.Data.put(partial, "open", restored_open)
  graph = RTS.Map.mark(mask + RTS.Map.repeat(".", 128), 65)
  List.do([0, 1, 3, 128], budget, do
    RTS.SearchParity.chunk(map, mask, restored, budget)
    RTS.SearchParity.chunk(map, graph, restored, budget)
  end)
end)
seed = 9173
scene = 0
while scene < 12 do
  blocked = ^ mask
  i = 0
  while i < 12 do
    seed = RTS.Data.random_next(seed)
    blocked = RTS.Map.mark(blocked, 1 + seed mod 62)
    i = i + 1
  end
  RTS.SearchParity.scene(map, blocked, 0, 63, scene mod 2 == 0, 3)
  scene = scene + 1
end

# Empty frontier and already-ready inputs exercise the non-expansion exits,
# including the historical clearing of the returned path on a ready re-entry.
ready = RTS.SearchReference.run(map, mask, RTS.Search.start(map, 0, 0, true), 1)
empty = RTS.Data.put(initial, "open", [])
List.do([0, 1, 3], budget, do
  returned = RTS.SearchParity.chunk(map, mask, ready, budget)
  exhausted = RTS.SearchParity.chunk(map, mask, empty, budget)
  RTS.Check.that("ready and empty-frontier exits retain their exact historical statuses",
    RTS.Data.get(returned, "status") == "ready" && RTS.Data.get(returned, "path") == [] &&
    RTS.Data.get(exhausted, "status") == if budget == 0 do "planning" else "unreachable" end)
end)

# Legal fine-grid shapes at/below the 9216-cell protocol limit. Only four
# expansions per scene: never complete a 9k-cell BFS merely to test storage.
List.do([{96, 96}, {512, 16}, {64, 144}, {1, 16}, {16, 1}], {width, height}, do
  large = %{"width" => width, "height" => height}
  count = width * height
  legacy = RTS.Map.repeat(".", count)
  graph = RTS.Map.repeat(".", count * 3)
  start = if width > 1 && height > 1 do width + 1 else 0 end
  goal = count - 1 - start
  edges = if width == 1 do [count * 2 + 1, count * 3 - 3] else
    if height == 1 do [count + 1, count * 2 - 3] else
      [count + start, count * 2 + start, count + goal - 1, count * 2 + goal - width]
    end
  end
  List.do(edges, edge, do graph = RTS.Map.mark(graph, edge) end)
  List.do([{start, goal}, {goal, start}], {from, to}, do
    List.do([true, false], astar, do
      current = RTS.Search.start(large, from, to, astar)
      # One legacy chunk additionally protects N-mask behavior at these sizes.
      RTS.SearchParity.chunk(large, legacy, RTS.Data.share(current), 1)
      current = RTS.Data.put(current, "mask", graph)
      original = RTS.Data.share(current)
      before = RTS.Wire.encode(original)
      List.do([0, 1, 3], budget, do
        current = JSON.from_str(RTS.Wire.encode(current))
        current = RTS.SearchParity.chunk(large, RTS.Data.get(current, "mask"), current, budget)
      end)
      RTS.Check.that("large/aspect graph resumes preserve the original snapshot and all mask planes",
        RTS.Wire.encode(original) == before && RTS.Data.get(current, "mask") == graph &&
        RTS.Data.get(current, "expanded") <= 4 &&
        type(RTS.Data.get(current, "parents")) == Str && type(RTS.Data.get(current, "costs")) == Str)
    end)
  end)
end)
